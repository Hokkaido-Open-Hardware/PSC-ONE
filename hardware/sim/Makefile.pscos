# ============================================================
# Usage
# ============================================================

# task切り替えテスト
#make -f Makefile.pscos simulate_PSCOS_MULTITASK SIM_USER=minimal SIM_FAST=1 RUN_CYCLES=30000000 

# ブートのみ高速確認テスト
#make -f Makefile.pscos simulate_PSCOS SIM_USER=minimal SIM_FAST=1

# micropythonリンクしないモード
#make -f Makefile.pscos simulate_PSCOS SIM_FAST=1

# 通常テスト
#make -f Makefile.pscos simulate_PSCOS

# 通常テスト（UART GUI OFF）
#make -f Makefile.pscos simulate_PSCOS PSC_UART_GUI=0

# FST Dump
#make -f Makefile.pscos simulate_PSCOS DUMP_FST=1

# GATE SIM
#make -f Makefile.pscos simulate_PSCOS SIM_LEVEL=GATE

# GATE SIM (SDF; Questa/ModelSim required)
#make -f Makefile.pscos simulate_PSCOS SIM_LEVEL=TIMING
# Optional: MODELSIM_BIN_DIR=/path/to/bin SDF_CORNER=max (default: typ)
# GATE/TIMING boot from SD; the CPU and boot ROM come from the netlist.
# Icarus 12 supports scalar SDF IOPATH delays, but not this full Gowin SDF.
# See ../../../report/pscos-gate-timing-20261107.md for measured limitations.

SIM_LEVEL ?= RTL
ifeq ($(filter $(SIM_LEVEL),RTL GATE TIMING),)
$(error SIM_LEVEL=$(SIM_LEVEL) is invalid; use RTL, GATE or TIMING)
endif

# ============================================================
#  MODE で一括切り替え（verilator / icarus）
# ============================================================
# PSC_OS実行のデフォルトはverilator
MODE = verilator
#MODE = icarus
#MODE = icarus_os

# ============================================================
#  シミュレーションモードに応じた設定
# ============================================================
ifeq ($(MODE),verilator)
SIM          		= verilator
SDRAM_MODEL  		= ../rtl/model/SDRAM_model/w9825g6kh_verilator.v
GW2AR_SDRAM_MODEL 	= ../rtl/model/SDRAM_model/GW2AR_sdram_verilator.v
SDCARD_MODEL 		= ../rtl/model/SDCARD_model/sdcard_spi_model.v
TOP_COMPILE_ARGS 	= -DTOP_SIM

ifeq ($(SIM_FAST),1)
EXTRA_ARGS = \
	-O3 --bbox-sys --x-assign fast --x-initial fast \
	--Wno-ASCRANGE --Wno-INITIALDLY --Wno-COMBDLY \
	--Wno-WIDTHEXPAND --Wno-WIDTHTRUNC --Wno-REALCVT \
	--Wno-MULTIDRIVEN
else
EXTRA_ARGS = \
	-O3 --trace --trace-fst \
	--Wno-ASCRANGE --Wno-INITIALDLY --Wno-COMBDLY \
	--Wno-WIDTHEXPAND --Wno-WIDTHTRUNC --Wno-REALCVT \
	--Wno-MULTIDRIVEN
endif

endif

ifeq ($(DUMP_FST),1)
VCD_COMPILE_ARGS 	= -DDUMP_FST
endif

ifeq ($(MODE),icarus)
SIM          		= icarus
SDRAM_MODEL    		= ../rtl/model/SDRAM_model/w9825g6kh.v 	# ← Icarus 用 Micron モデルに修正
GW2AR_SDRAM_MODEL 	= ../rtl/model/SDRAM_model/GW2AR_sdram.v
SDCARD_MODEL		= ../rtl/model/SDCARD_model/sdcard_spi_model.v

EXTRA_ARGS =   # Icarus は基本オプション不要（必要なら -g2012 など）
TOP_COMPILE_ARGS 	= -DTOP_SIM
VCD_COMPILE_ARGS 	= -DDUMP_VCD

endif

ifeq ($(MODE),icarus_os)
SIM          		= icarus
SDRAM_MODEL  		= ../rtl/model/SDRAM_model/w9825g6kh.v  # ← Icarus 用 Micron モデルに修正
GW2AR_SDRAM_MODEL 	= ../rtl/model/SDRAM_model/GW2AR_sdram.v
SDCARD_MODEL 		= ../rtl/model/SDCARD_model/sdcard_spi_model.v

EXTRA_ARGS =   # Icarus は基本オプション不要（必要なら -g2012 など）
TOP_COMPILE_ARGS 	= -DTOP_SIM
VCD_COMPILE_ARGS 	= -DDUMP_VCD

endif

ifeq ($(SDRAM_MODEL),)
$(error MODE=$(MODE) は不正です。MODE=verilator または MODE=icarus を指定してください)
endif

# ============================================================
#  以下、元の Makefile の変数定義など（SDRAM_MODEL を置き換え）
# ============================================================

TOP          = PSC_RV32IS_Chip_sim
PSCONE_TOP   = PSC_ONE_Chip_sim

CPU_SRC_DIR  = ../rtl/soc/cpu/src
TOP_SRC_DIR  = ../rtl/tang20k/top
CACHE_DIR    = ../rtl/soc/cache/src
SOC_TOP_SRC_DIR  = ../rtl/soc/soc_top

PSCONE_SIM_TOP_FILE = \
	$(TOP_SRC_DIR)/PSC_ONE_Chip_sim.v \

PSCONE_TOP_FILE = \
	$(TOP_SRC_DIR)/PSC_ONE_Chip.v

PSCONE_SOC_TOP_FILE = \
	$(SOC_TOP_SRC_DIR)/PSC_ONE_SOC.v

# RV32_core
CPU_CORE_FILES = \
	$(CPU_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_SRC_DIR)/PSC_RV32_core.v \
	$(CPU_SRC_DIR)/PSC_RV32_Fetch.v \
	$(CPU_SRC_DIR)/PSC_RV32_Execute.v \
	$(CPU_SRC_DIR)/Fetch_Fifo.v \
	$(CPU_SRC_DIR)/Fetch.v \
	$(CPU_SRC_DIR)/Decorder.v \
	$(CPU_SRC_DIR)/Execute.v \
	$(CPU_SRC_DIR)/Execute_Divider.v \
	$(CPU_SRC_DIR)/Execute_Mul.v \
	$(CPU_SRC_DIR)/Branch.v \
	$(CPU_SRC_DIR)/MemoryStore.v \
	$(CPU_SRC_DIR)/Register.v \
	$(CPU_SRC_DIR)/MMU.v \
	$(CPU_SRC_DIR)/Csr.v \
	$(CPU_SRC_DIR)/PSC_RV32_Monitor.v

CPU_V1_SRC_DIR  = ../rtl/soc/cpu_v1/src

# RV32_core
CPU_V1_CORE_FILES = \
	$(CPU_V1_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_V1_SRC_DIR)/PSC_Types.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_core.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_FetchUnit.sv \
	$(CPU_V1_SRC_DIR)/PSC_FetchPredict.sv \
	$(CPU_V1_SRC_DIR)/Fetch_Fifo.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_InstructionEngine.sv \
	$(CPU_V1_SRC_DIR)/PSC_InstructionUnit.sv \
	$(CPU_V1_SRC_DIR)/Fetch.sv \
	$(CPU_V1_SRC_DIR)/Decorder.sv \
	$(CPU_V1_SRC_DIR)/Execute.sv \
	$(CPU_V1_SRC_DIR)/Execute_Divider.sv \
	$(CPU_V1_SRC_DIR)/Execute_Mul.sv \
	$(CPU_V1_SRC_DIR)/Branch.sv \
	$(CPU_V1_SRC_DIR)/MemoryStore.sv \
	$(CPU_V1_SRC_DIR)/PSC_Register.sv \
	$(CPU_V1_SRC_DIR)/PSC_PC.sv \
	$(CPU_V1_SRC_DIR)/MMU.sv \
	$(CPU_V1_SRC_DIR)/Csr.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_Monitor.v

CPU_V2_SRC_DIR  = ../rtl/soc/cpu_v2_experimental/src

# RV32_core(V2)
CPU_V2_CORE_FILES = \
	$(CPU_V2_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_V2_SRC_DIR)/PSC_Types.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_core.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_FetchUnit.sv \
	$(CPU_V2_SRC_DIR)/Fetch_Fifo.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_InstructionEngine.sv \
	$(CPU_V2_SRC_DIR)/PSC_InstructionUnit.sv \
	$(CPU_V2_SRC_DIR)/Fetch.sv \
	$(CPU_V2_SRC_DIR)/Decorder.sv \
	$(CPU_V2_SRC_DIR)/Execute.sv \
	$(CPU_V2_SRC_DIR)/Execute_Divider.sv \
	$(CPU_V2_SRC_DIR)/Execute_Mul.sv \
	$(CPU_V2_SRC_DIR)/Branch.sv \
	$(CPU_V2_SRC_DIR)/MemoryStore.sv \
	$(CPU_V2_SRC_DIR)/PSC_Register.sv \
	$(CPU_V2_SRC_DIR)/PSC_PC.sv \
	$(CPU_V2_SRC_DIR)/MMU.sv \
	$(CPU_V2_SRC_DIR)/Csr.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_Monitor.v

MMIO_DIR	= ../rtl/soc/mmio/MMIO
UART_DIR	= ../rtl/soc/mmio/UART
I2C_DIR		= ../rtl/soc/mmio/I2C
LED_DIR		= ../rtl/soc/mmio/LED

# ============================================================
# CPUコアの切り替え（v1 / legacy）
# ============================================================
# デフォルトはV1
CPU_VERSION ?= v1

ifeq ($(CPU_VERSION),v1)
SELECTED_CPU_CORE_FILES = $(CPU_V1_CORE_FILES)
else ifeq ($(CPU_VERSION),v2)
SELECTED_CPU_CORE_FILES = $(CPU_V2_CORE_FILES)
else ifeq ($(CPU_VERSION),legacy)
SELECTED_CPU_CORE_FILES = $(CPU_CORE_FILES)
else
$(error CPU_VERSION=$(CPU_VERSION) は不正です。v1 または legacy を指定してください)
endif

# CPU_core + Cache
CPU_FILES = \
	$(SELECTED_CPU_CORE_FILES) \
	$(MMIO_DIR)/PSC_RV32IS_MMapped_IO.v \
	$(UART_DIR)/PSC_RV32IS_UART.v \
	$(I2C_DIR)/PSC_I2C_capture.sv \
	$(I2C_DIR)/PSC_RV32_I2C.sv \
	$(LED_DIR)/PSC_RV32IS_LED.v \
	$(CACHE_DIR)/cache_dma_controller.sv \
	$(CACHE_DIR)/cache_dma_controller_io.sv \
	$(CACHE_DIR)/dm_cache_data.v \
	$(CACHE_DIR)/dm_cache_tag.v \
	$(TOP_SRC_DIR)/Delay_N.v

AXI_DIR			= ../rtl/soc/axi
SDRAM_CNT_DIR	= ../rtl/tang20k/sdram_controller
BOOT_SRC_DIR	= ../rtl/soc/boot
DMA_SRC_DIR		= ../rtl/soc/dma

SDRAM_32bit_AXI_FILES = \
	$(AXI_DIR)/PSC_RV32_CacheAXI.v \
	$(SDRAM_CNT_DIR)/sdram_axi_controller.v \
	$(SDRAM_CNT_DIR)/sdram_controller.sv \
	$(GW2AR_SDRAM_MODEL)

PSC_ONE_BOOT_FILE = $(BOOT_SRC_DIR)/PSC_ONE_Boot_axi.v

PSC_ONE_DMA_FILE =  $(DMA_SRC_DIR)/PSC_ONE_DMA_axi.v

# ============================================================
# NPU implementation selection (v1 / v2 / legacy)
# ============================================================

# デフォルトはlegacy
NPU_VERSION ?= legacy

NPU_LEGACY_DIR = ../rtl/soc/npu/src
NPU_V1_DIR     = ../rtl/soc/npu_v1/src
NPU_V2_DIR     = ../rtl/soc/npu_v2/src

# NPU V1: 4 MUL -> 4 fixed WB lanes -> 16 ACC bank
NPU_V1_FILES = \
	$(NPU_V1_DIR)/PSC_NPU_Controller.v \
	$(NPU_V1_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V1_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V1_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V1_DIR)/PSC_NPU_Mul4.sv \
	$(NPU_V1_DIR)/PSC_NPU_AccBank.sv

# NPU V2: selector 8 lanes, two signed power-of-two terms per weight byte.
NPU_V2_FILES = \
	$(NPU_V2_DIR)/PSC_NPU_Controller.v \
	$(NPU_V2_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V2_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V2_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V2_DIR)/PSC_NPU_PotLanes.sv \
	$(NPU_V2_DIR)/PSC_NPU_AccBank.sv

# Legacy NPU
NPU_LEGACY_FILES = \
	$(NPU_LEGACY_DIR)/PSC_NPU_Controller.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_Engine.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_Requantize.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_TilePost.sv \
	$(NPU_LEGACY_DIR)/PSC_LPU_Controller.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_ReadController.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_INT.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_Mult.sv

ifeq ($(NPU_VERSION),v1)
SA_DIR  = $(NPU_V1_DIR)
SA_FILE = $(NPU_V1_FILES)
else ifeq ($(NPU_VERSION),v2)
SA_DIR  = $(NPU_V2_DIR)
SA_FILE = $(NPU_V2_FILES)
else ifeq ($(NPU_VERSION),legacy)
SA_DIR  = $(NPU_LEGACY_DIR)
SA_FILE = $(NPU_LEGACY_FILES)
else
$(error NPU_VERSION=$(NPU_VERSION) は不正です。v1 / v2 / legacy を指定してください)
endif

MMIO_BASE_DIR	= ../rtl/soc/mmio

# LCD
PSCONELCD_FILE = \
	$(MMIO_BASE_DIR)/LCD/PSC_ONE_LCD.v \
	$(MMIO_BASE_DIR)/LCD/tft_clock_divider.v \
	$(MMIO_BASE_DIR)/LCD/tft_ili9488.v \
	$(MMIO_BASE_DIR)/LCD/tft_ili9488_spi.v

# SD Card Reader
SD_READER_FILE = \
	$(MMIO_BASE_DIR)/PSC_SDCARD/src/PSC_SDCard.sv \
	$(MMIO_BASE_DIR)/PSC_SDCARD/src/PSC_SDCard_SPI.sv 

# PSC Phase Flow Engine
FPE_DIR  = ../rtl/soc/pfe/src
FPE_FILE = \
	$(FPE_DIR)/PSC_PFE.v

# Timer
TIMER_FILE = $(MMIO_BASE_DIR)/TIMER/PSC_RV32IS_TIMER.v

# I2S Rx
I2S_RX_FILE = \
	$(MMIO_BASE_DIR)/I2S_RX/PSC_I2SRX.sv \

I2S_MIC_MODEL = ../rtl/model/I2S_MIC_MODEL/PSC_I2S_MIC_MODEL.v

LCD_ILI9488_MODEL = ../rtl/model/LCD_model/PSC_LCD_ILI9488_MODEL.v

INPUT_PSCONE_SIM_FILE = \
	$(PSCONE_SIM_TOP_FILE) $(PSCONE_TOP_FILE) $(PSCONE_SOC_TOP_FILE) \
	$(CPU_FILES) $(SDRAM_32bit_AXI_FILES) \
	$(PSC_ONE_BOOT_FILE) $(PSC_ONE_DMA_FILE) \
	$(SA_FILE) $(PSCONELCD_FILE) $(SD_READER_FILE) $(TIMER_FILE) \
	$(I2S_RX_FILE) $(I2S_MIC_MODEL) $(LCD_ILI9488_MODEL) \
	$(FPE_FILE) \
	$(SDCARD_MODEL)

INPUT_FILE_PSCONE = \
	$(INPUT_PSCONE_SIM_FILE)

COCOTB_CFG       := $(shell which cocotb-config)
COCOTB_MAKEFILE  := $(shell cocotb-config --makefiles)/Makefile.sim
ifeq ($(NPU_VERSION),v2)
# Do not reuse a simulator binary built for the INT8 NPU implementations.
export SIM_BUILD ?= sim_build/npu_v2
else
SIM_BUILD        ?= sim_build
endif

.PHONY: compile_cpp

# ============================================================
# シミュレーションターゲット
# ============================================================
# PSC-OS テスト

# Retain ELF/map files for fault analysis and keep boot-flow-dependent objects
# separate. MODE/BIOS_FLAGS are not file prerequisites in the OS Makefile.
PSCOS_BUILD_ROOT ?= $(abspath build/pscos/$(CPU_VERSION)/$(if $(SIM_USER),$(SIM_USER),full))
PSCOS_DIRECT_BUILD = $(PSCOS_BUILD_ROOT)/direct
PSCOS_SD_BUILD = $(PSCOS_BUILD_ROOT)/sd
PSCOS_LOADER_BUILD = $(PSCOS_BUILD_ROOT)/loader

# Allow Rust firmware builds to reuse source/tool configuration without C targets.
ifndef PSCOS_CONFIG_ONLY

# ============================================================
# GATE / TIMING: netlist simulation (RTL targets follow below)
# ============================================================
ifneq ($(filter $(SIM_LEVEL),GATE TIMING),)
# Gate-level configuration for SIM_LEVEL=GATE / TIMING.
# Run from hardware/sim. The CPU and boot ROM are fixed by the Gowin netlist;
# both modes boot the C OS from SD, without RTL hierarchical memory loading.
PSCOS_SIM_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
GOWIN_IMPL ?= /home/haruhiko/Program/Gowin/PSC-ONE_RV32/impl
GATE_CLOCK_PERIOD_NS ?= 37.038
GATE_UART_BIT_NS ?= 8568
GATE_SDRAM_TAC_NS ?= 5.4
GATE_SDRAM_INIT_ZERO ?= 1
GATE_RUN_DIR ?= $(PSCOS_SIM_DIR)/build/pscos-netlist/$(SIM_LEVEL)/$(if $(SIM_USER),$(SIM_USER),full)
PSCOS_GATE_BUILD := $(abspath $(GATE_RUN_DIR))/sim_build
PSCOS_GATE_OS_BUILD := $(abspath $(GATE_RUN_DIR))/os

ifeq ($(SIM_LEVEL),GATE)
GATE_NETLIST ?= $(GOWIN_IMPL)/gwsynthesis/PSC-ONE_RV32.vg
GOWIN_SIMLIB ?= /opt/gowin/IDE/simlib/gw2a/prim_sim.v
# Existing functional RV32 model workaround; see the SDRAM hold report.
# No routing delays are present in the synthesis netlist.
GATE_SDRAM_TOH_NS ?= 5.0
PSCOS_GATE_SIM := icarus
PSCOS_GATE_COMPILE_ARGS := -g2012 \
	-PPSC_ONE_Chip_gate_sim.CLOCK_PERIOD_NS=$(GATE_CLOCK_PERIOD_NS) \
	-PPSC_ONE_Chip_gate_sim.SDRAM_TAC_NS=$(GATE_SDRAM_TAC_NS) \
	-PPSC_ONE_Chip_gate_sim.SDRAM_TOH_NS=$(GATE_SDRAM_TOH_NS)
ifeq ($(GATE_SDRAM_INIT_ZERO),1)
PSCOS_GATE_COMPILE_ARGS += -DINIT_CLEAR_MEM_BANKS
endif
ifeq ($(DUMP_FST),1)
PSCOS_GATE_COMPILE_ARGS += -DDUMP_FST
PSCOS_GATE_PLUSARGS := -fst
endif
else
GATE_NETLIST ?= $(GOWIN_IMPL)/pnr/PSC-ONE_RV32.vo
GATE_SDF ?= $(GOWIN_IMPL)/pnr/PSC-ONE_RV32.sdf
GOWIN_SIMLIB ?= /opt/gowin/IDE/simlib/gw2a/prim_tsim.v
# Use the original SDRAM timings for post-route simulation.
GATE_SDRAM_TOH_NS ?= 3.0
SDF_CORNER ?= typ
ifeq ($(filter $(SDF_CORNER),min typ max),)
$(error SDF_CORNER=$(SDF_CORNER) is invalid; use min, typ or max)
endif
ifeq ($(DUMP_FST),1)
$(error TIMING uses Questa/ModelSim; use WAVES=1 for WLF instead of DUMP_FST=1)
endif
# Icarus 12 cannot compile Gowin's bit-selected specify paths, and cannot
# provide complete SDF timing checks. Do not silently run a partial SDF model.
PSCOS_GATE_SIM := questa-compat
PSCOS_GATE_COMPILE_ARGS :=
ifeq ($(GATE_SDRAM_INIT_ZERO),1)
PSCOS_GATE_COMPILE_ARGS += +define+INIT_CLEAR_MEM_BANKS
endif
PSCOS_GATE_SIM_ARGS := -t 1ps \
	-gCLOCK_PERIOD_NS=$(GATE_CLOCK_PERIOD_NS) \
	-gSDRAM_TAC_NS=$(GATE_SDRAM_TAC_NS) \
	-gSDRAM_TOH_NS=$(GATE_SDRAM_TOH_NS) \
	-sdf$(SDF_CORNER) /PSC_ONE_Chip_gate_sim/u_chip=$(abspath $(GATE_SDF))
PSCOS_GATE_SIM_DEPS := $(abspath $(GATE_SDF))
endif

# The SDRAM model inherits the harness timescale: preserve this source order.
PSCOS_GATE_SOURCES := $(abspath $(GATE_NETLIST)) $(abspath $(GOWIN_SIMLIB)) \
	$(PSCOS_SIM_DIR)/testbench/PSC_ONE_Chip_gate_sim.sv \
	$(abspath $(PSCOS_SIM_DIR)/../rtl/model/SDRAM_model/GW2AR_sdram.v) \
	$(abspath $(PSCOS_SIM_DIR)/../rtl/model/SDCARD_model/sdcard_spi_model.v)

.PHONY: simulate_PSCOS simulate_SD_PSCOS check_pscos_gate_inputs \
	prepare_pscos_gate pscos_gate_config run_pscos_gate

# Keep the same default entry point as the RTL Makefile.
simulate_PSCOS: prepare_pscos_gate
	$(MAKE) -f $(PSCOS_SIM_DIR)/Makefile.pscos run_pscos_gate

simulate_SD_PSCOS: simulate_PSCOS

check_pscos_gate_inputs:
	@test -r "$(GATE_NETLIST)" || { echo "Missing GATE_NETLIST: $(GATE_NETLIST)"; exit 1; }
	@test -r "$(GOWIN_SIMLIB)" || { echo "Missing GOWIN_SIMLIB: $(GOWIN_SIMLIB)"; exit 1; }
	@test -f "$(COCOTB_MAKEFILE)" || { echo "cocotb-config is not available; activate myenv."; exit 1; }
ifeq ($(SIM_LEVEL),TIMING)
	@test -r "$(GATE_SDF)" || { echo "Missing GATE_SDF: $(GATE_SDF)"; exit 1; }
	@command -v $(if $(MODELSIM_BIN_DIR),$(MODELSIM_BIN_DIR)/)vsim >/dev/null && \
	 command -v $(if $(MODELSIM_BIN_DIR),$(MODELSIM_BIN_DIR)/)vlog >/dev/null || \
	 { echo "TIMING requires Questa/ModelSim (vsim/vlog). Set MODELSIM_BIN_DIR to its bin directory. Icarus 12 cannot run this Gowin timing library."; exit 1; }
else
	@command -v iverilog >/dev/null && command -v vvp >/dev/null
endif

prepare_pscos_gate: check_pscos_gate_inputs
	$(MAKE) -C $(PSCOS_SIM_DIR)/../../software/os MODE=fpga_mem \
		Build=$(PSCOS_GATE_OS_BUILD) KERNEL_USER_FROM_SD=1 \
		$(if $(SIM_USER),SIM_USER=$(SIM_USER),) fpga_mem
	$(MAKE) -C $(PSCOS_SIM_DIR) -f Makefile.sdcard \
		INPUT_DIR=$(PSCOS_GATE_OS_BUILD) SDCARD_DIR=$(abspath $(GATE_RUN_DIR))/sdcard all

# Track settings and source selection as well as file timestamps.
pscos_gate_config: check_pscos_gate_inputs
	@python3 -c 'from pathlib import Path; import sys; p=Path(sys.argv[1]); s="\n".join(sys.argv[2:])+"\n"; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(s) if not p.exists() or p.read_text()!=s else None' "$(PSCOS_GATE_BUILD)/gate.config" "$(PSCOS_GATE_SOURCES)" "$(PSCOS_GATE_COMPILE_ARGS)" "$(PSCOS_GATE_SIM_ARGS)"

# Re-run an already prepared SD image without rebuilding the OS.
run_pscos_gate: pscos_gate_config
	@test -r "$(GATE_RUN_DIR)/sdcard/sdcard.hex" || { echo "Run simulate_PSCOS first to prepare the SD image."; exit 1; }
	mkdir -p $(GATE_RUN_DIR)/wave $(GATE_RUN_DIR)/log_uart
	@echo "[PSC-OS $(SIM_LEVEL)] netlist=$(GATE_NETLIST) simulator=$(PSCOS_GATE_SIM)"
	@echo "[PSC-OS $(SIM_LEVEL)] Boot ROM/CPU are fixed by the netlist; C OS boots from SD."
	@echo "[PSC-OS $(SIM_LEVEL)] SDRAM tAC=$(GATE_SDRAM_TAC_NS) ns, tOH=$(GATE_SDRAM_TOH_NS) ns"
ifeq ($(SIM_LEVEL),TIMING)
	@echo "[PSC-OS TIMING] SDF=$(GATE_SDF) corner=$(SDF_CORNER) instance=/PSC_ONE_Chip_gate_sim/u_chip"
endif
	cd $(GATE_RUN_DIR) && \
	PYTHONPATH=$(PSCOS_SIM_DIR):$(PYTHONPATH) \
	COCOTB_TEST_MODULES=cocotb_tb.psc_os.test_gate_rv32 \
	UART_BIT_NS=$(GATE_UART_BIT_NS) GATE_CLOCK_PERIOD_NS=$(GATE_CLOCK_PERIOD_NS) \
	COCOTB_RESULTS_FILE=$(PSCOS_GATE_BUILD)/results.xml \
	PSC_UART_LOGFILE=$(abspath $(GATE_RUN_DIR))/log_uart/uart.log \
	TOPLEVEL=PSC_ONE_Chip_gate_sim TOPLEVEL_LANG=verilog \
	SIM=$(PSCOS_GATE_SIM) SIM_BUILD=$(PSCOS_GATE_BUILD) \
	VERILOG_SOURCES="$(PSCOS_GATE_SOURCES)" \
	CUSTOM_COMPILE_DEPS="$(PSCOS_GATE_BUILD)/gate.config" \
	CUSTOM_SIM_DEPS="$(PSCOS_GATE_SIM_DEPS)" \
	COMPILE_ARGS="$(PSCOS_GATE_COMPILE_ARGS)" \
	SIM_ARGS="$(PSCOS_GATE_SIM_ARGS)" EXTRA_ARGS= \
	COCOTB_PLUSARGS="$(PSCOS_GATE_PLUSARGS)" \
	$(MAKE) --silent -f $(COCOTB_MAKEFILE)

else

simulate_PSCOS: MODE = verilator
simulate_PSCOS: SIM = verilator
simulate_PSCOS: VDEF = -DFST_UART_MODE -DPSCOS_SIM -DPSCOS_NO_SDCARD
simulate_PSCOS: export SIM_BUILD = build/pscos-sim/direct_$(CPU_VERSION)_$(NPU_VERSION)_$(if $(SIM_FAST),$(SIM_FAST),0)

simulate_PSCOS: 
	$(MAKE) -C ../../software/os Build=$(PSCOS_DIRECT_BUILD) KERNEL_USER_FROM_SD=0 $(if $(SIM_USER),SIM_USER=$(SIM_USER),) sim_mem
	mkdir -p ./mem
	cp $(PSCOS_DIRECT_BUILD)/bootrom.mem ./mem/
	cp $(PSCOS_DIRECT_BUILD)/kernel.mem ./mem/
	cp $(PSCOS_DIRECT_BUILD)/user.mem ./mem/

	test -f ./mem/bootrom.mem
	test -f ./mem/kernel.mem
	test -f ./mem/user.mem

	grep -n -v '^00000000$$' ./mem/bootrom.mem | tail -n 1
	grep -n -v '^00000000$$' ./mem/kernel.mem | tail -n 1
	grep -n -v '^00000000$$' ./mem/user.mem | tail -n 1

	@tmp=$$(mktemp); \
	head -n 128 ./mem/bootrom.mem > $$tmp; \
	mv $$tmp ./mem/bootrom.mem
	
	@mkdir -p ./wave
	@mkdir -p ./log_uart

	@echo "MODE=$(MODE)"
	@echo "CPU_VERSION=$(CPU_VERSION)"
	@echo VDEF=$(VDEF)
	@echo EXTRA_ARGS=$(EXTRA_ARGS)

	@echo "[SIM] MODE=$(MODE), SIM=$(SIM)"
	MODULE=cocotb_tb.psc_os.PSCONE_os_test \
	PSC_OS_KERNEL_ELF=$(PSCOS_DIRECT_BUILD)/kernel.elf \
	COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/results.xml \
	PSC_UART_LOGFILE=./log_uart/log_$$(date +%Y_%m_%d_%H%M%S).log \
	EXPECTED_RESULT=0xff00ff1b \
	TOPLEVEL=$(PSCONE_TOP) TOPLEVEL_LANG=verilog \
	SIM=$(SIM) \
	VERILOG_SOURCES="$(INPUT_FILE_PSCONE)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS) $(VDEF)" \
	EXTRA_ARGS="$(EXTRA_ARGS)" \
	$(MAKE) --silent -f $(COCOTB_MAKEFILE)

# ============================================================
# シミュレーションターゲット
# ============================================================
# SDカードからPSC-OS テスト

simulate_SD_PSCOS: MODE = verilator
simulate_SD_PSCOS: SIM = verilator
simulate_SD_PSCOS: VDEF = -DFST_UART_MODE -DPSCOS_SIM -DFPGA_BOOT_LOADER_MODE
simulate_SD_PSCOS: export SIM_BUILD = build/pscos-sim/sd_$(CPU_VERSION)_$(NPU_VERSION)_$(if $(SIM_FAST),$(SIM_FAST),0)

simulate_SD_PSCOS:
	$(MAKE) -C ../../software/os Build=$(PSCOS_SD_BUILD) KERNEL_USER_FROM_SD=1 $(if $(SIM_USER),SIM_USER=$(SIM_USER),) fpga_mem
	$(MAKE) -C ../../software/os Build=$(PSCOS_LOADER_BUILD) fpga_fat32_boot
	mkdir -p ./mem
	cp $(PSCOS_LOADER_BUILD)/bootrom.mem ./mem/
	cp $(PSCOS_LOADER_BUILD)/bootloader_fat32.mem ./mem/
	cp $(PSCOS_SD_BUILD)/kernel.mem ./mem/
	cp $(PSCOS_SD_BUILD)/user.mem ./mem/
	# all verifies both FAT32 files byte-for-byte and exports sdcard.hex.
	$(MAKE) -f Makefile.sdcard INPUT_DIR=mem all

	test -f ./mem/bootrom.mem
	test -f ./mem/bootloader_fat32.mem
	test -f ./mem/kernel.mem
	test -f ./mem/user.mem

	grep -n -v '^00000000$$' ./mem/bootloader_fat32.mem | tail -n 1
	grep -n -v '^00000000$$' ./mem/kernel.mem | tail -n 1
	grep -n -v '^00000000$$' ./mem/user.mem | tail -n 1
	
	@mkdir -p ./wave
	@mkdir -p ./log_uart

	@echo "MODE=$(MODE)"
	@echo "CPU_VERSION=$(CPU_VERSION)"
	@echo VDEF=$(VDEF)
	@echo EXTRA_ARGS=$(EXTRA_ARGS)

	@echo "[SIM] MODE=$(MODE), SIM=$(SIM)"
	MODULE=cocotb_tb.psc_os.PSCONE_os_test \
	PSC_OS_KERNEL_ELF=$(PSCOS_SD_BUILD)/kernel.elf \
	COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/results.xml \
	PSC_UART_LOGFILE=./log_uart/log_$$(date +%Y_%m_%d_%H%M%S).log \
	EXPECTED_RESULT=0xff00ff1b \
	TOPLEVEL=$(PSCONE_TOP) TOPLEVEL_LANG=verilog \
	SIM=$(SIM) \
	VERILOG_SOURCES="$(INPUT_FILE_PSCONE)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS) $(VDEF)" \
	EXTRA_ARGS="$(EXTRA_ARGS)" \
	$(MAKE) --silent -f $(COCOTB_MAKEFILE)

endif # RTL / GATE / TIMING

# ============================================================
# PSC-OS preemptive two-process scheduler timer-IRQ test
# ============================================================
# This target uses a test-only kernel build.  The normal simulate_PSCOS
# target above remains the PSC-OS baseline regression test.

simulate_PSCOS_MULTITASK:
	$(MAKE) clean
	$(MAKE) -C ../../software/os MODE=sim ./build/bootrom.mem
	$(MAKE) -C ../../software/os MODE=sim KCPPFLAGS="-DBSS_CLEAR_OFF=1 -DPSC_OS_DUMMY_TEST=1" kernel_mem
	$(MAKE) -C ../../software/os MODE=sim ./build/user.mem
	cp ../../software/os/build/bootrom.mem ./mem/
	cp ../../software/os/build/kernel.mem ./mem/
	cp ../../software/os/build/user.mem ./mem/
	$(MAKE) -C ../../software/os clean
	test -f ./mem/bootrom.mem
	test -f ./mem/kernel.mem
	test -f ./mem/user.mem
	@mkdir -p ./wave ./log_uart
	@echo "MODE=$(MODE)"
	@echo "CPU_VERSION=$(CPU_VERSION)"
	@echo "NPU_VERSION=$(NPU_VERSION)"
	@echo "[SIM] PSC-OS 1ms timer preemption test, SIM=$(SIM)"
	MODULE=cocotb_tb.psc_os.PSCONE_multitask_test \
	PSC_UART_LOGFILE=./log_uart/log_$$(date +%Y_%m_%d_%H%M%S).log \
	TOPLEVEL=$(PSCONE_TOP) TOPLEVEL_LANG=verilog \
	SIM=$(SIM) \
	VERILOG_SOURCES="$(INPUT_FILE_PSCONE)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS)" \
	EXTRA_ARGS="$(EXTRA_ARGS) $(VDEF)" \
	make --silent -f $(COCOTB_MAKEFILE); \
	printf '\a'

# UART LOG MODE
simulate_PSCOS_MULTITASK_LOG:
	$(MAKE) clean
	$(MAKE) -C ../../software/os MODE=sim ./build/bootrom.mem
	$(MAKE) -C ../../software/os MODE=sim KCPPFLAGS="-DBSS_CLEAR_OFF=1 -DPSC_OS_DUMMY_TEST=1" kernel_mem
	$(MAKE) -C ../../software/os MODE=sim ./build/user.mem
	cp ../../software/os/build/bootrom.mem ./mem/
	cp ../../software/os/build/kernel.mem ./mem/
	cp ../../software/os/build/user.mem ./mem/
	$(MAKE) -C ../../software/os clean
	test -f ./mem/bootrom.mem
	test -f ./mem/kernel.mem
	test -f ./mem/user.mem
	@mkdir -p ./wave ./log_uart
	@echo "MODE=$(MODE)"
	@echo "CPU_VERSION=$(CPU_VERSION)"
	@echo "NPU_VERSION=$(NPU_VERSION)"
	@echo "[SIM] PSC-OS 1ms timer preemption test, SIM=$(SIM)"
	MODULE=cocotb_tb.psc_os.PSCONE_os_test \
	PSC_UART_LOGFILE=./log_uart/log_$$(date +%Y_%m_%d_%H%M%S).log \
	TOPLEVEL=$(PSCONE_TOP) TOPLEVEL_LANG=verilog \
	SIM=$(SIM) \
	VERILOG_SOURCES="$(INPUT_FILE_PSCONE)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS)" \
	EXTRA_ARGS="$(EXTRA_ARGS) $(VDEF)" \
	make --silent -f $(COCOTB_MAKEFILE); \
	printf '\a'

endif # PSCOS_CONFIG_ONLY
