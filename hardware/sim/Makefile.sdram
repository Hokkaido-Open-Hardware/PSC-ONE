# ============================================================
# Usage
# ============================================================

#TBD

# ============================================================
#  SIMULATOR 切り替え (MODE=icarus / verilator)
# ============================================================
MODE  = icarus
#MODE  = verilator
SIM  := $(MODE)

# ------------------------------------------------------------
#  Verilator / Icarus ごとの設定
# ------------------------------------------------------------
ifeq ($(MODE),verilator)
SIM          		= verilator
GW2AR_SDRAM_MODEL 	= ../rtl/model/SDRAM_model/GW2AR_sdram_verilator.v
TOP_COMPILE_ARGS 	= -DSDRAM_CNT_SIM -DCOCOTB_SIM
EXTRA_ARGS = \
	-O3 --trace --trace-fst \
	--Wno-ASCRANGE --Wno-INITIALDLY --Wno-COMBDLY \
	--Wno-WIDTHEXPAND --Wno-WIDTHTRUNC --Wno-REALCVT

endif

ifeq ($(MODE),icarus)
SIM          		= icarus
GW2AR_SDRAM_MODEL 	= ../rtl/model/SDRAM_model/GW2AR_sdram.v

EXTRA_ARGS =
TOP_COMPILE_ARGS 	= -DSDRAM_CNT_SIM -DCOCOTB_SIM 
VCD_COMPILE_ARGS 	= -DDUMP_VCD

endif

# ============================================================
#  Cocotb / コンパイル共通設定
# ============================================================
DEFS += COCOTB_SIM=1
ifeq ($(READ_MEM),1)
DEFS += READ_MEM
endif

# -D マクロ & SystemVerilog 有効化（Icarus / Verilator 両対応）
VLOG_ARGS = -g2012 $(addprefix -D,$(DEFS))

COCOTB_MAKEFILE  := $(shell cocotb-config --makefiles)/Makefile.sim

# ============================================================
#  ソース一覧
# ============================================================
SRC_SIMTOP = \
	../rtl/tang20k/sdram_controller/sim_sdram_controller.v
SRC_SDRAM_CNT = \
	../rtl/tang20k/sdram_controller/sdram_controller.sv \

SIM_SRC = $(SRC_SIMTOP) $(SRC_SDRAM_CNT) $(GW2AR_SDRAM_MODEL)
	
# ============================================================
#  Cocotb simulation targets
# ============================================================
simulate_SDRAM:
	@echo "[SIM] MODE=$(MODE), SIM=$(SIM) (PSC_SDRAM_CONTROLLER test)"
	@echo EXTRA_ARGS=$(EXTRA_ARGS)
	@echo "TOP_COMPILE_ARGS=$(TOP_COMPILE_ARGS)"
	$(MAKE) clean
	@mkdir -p ./wave
	# clean already forces a rebuild/run. Avoid the recursive sim target,
	# which re-exports COMPILE_ARGS and appends Icarus cmds.f a second time.
	COCOTB_TEST_MODULES=cocotb_tb.sdram.sdram_test \
	TOPLEVEL=sim_sdram_controller TOPLEVEL_LANG=verilog \
	SIM=$(SIM) \
	VERILOG_SOURCES="$(SIM_SRC)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS)" \
	VLOG_ARGS="$(VLOG_ARGS)" \
	EXTRA_ARGS="$(EXTRA_ARGS)" \
	$(MAKE) -f $(COCOTB_MAKEFILE) regression
