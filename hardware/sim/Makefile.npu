#--------------------------------------------------
# MODE
#--------------------------------------------------
#MODE = verilator
MODE = icarus

#--------------------------------------------------
# 共通 define
#--------------------------------------------------
DEFS := COCOTB_SIM=1 NPU_ASSERTIONS=1

#--------------------------------------------------
# simulator 別
#--------------------------------------------------
ifeq ($(MODE),verilator)

SIM := verilator

SIM_ARG_NAME := EXTRA_ARGS

SIM_ARGS := \
	$(addprefix -D,$(DEFS)) \
	--trace \
	--trace-fst \
	--Wno-ASCRANGE \
	--Wno-INITIALDLY \
	--Wno-COMBDLY \
	--Wno-WIDTHEXPAND \
	--Wno-WIDTHTRUNC \
	--Wno-REALCVT

endif


ifeq ($(MODE),icarus)

SIM := icarus

SIM_ARG_NAME := COMPILE_ARGS

SIM_ARGS := \
	$(addprefix -D,$(DEFS)) \
	-DDUMP_VCD=1

endif

#--------------------------------------------------
# defineを最後に展開
#--------------------------------------------------
SIM_COMPILE_ARGS := $(addprefix -D,$(DEFS))

#--------------------------------------------------
# MODE チェック
#--------------------------------------------------
ifeq ($(SIM),)
$(error MODE=$(MODE) は不正です。MODE=verilator または MODE=icarus を指定してください)
endif

#--------------------------------------------------
# 子 make へ環境変数として渡す
#--------------------------------------------------
export SIM_COMPILE_ARGS
export EXTRA_ARGS

#--------------------------------------------------
# Cocotb Makefile
#--------------------------------------------------
COCOTB_MAKEFILE := $(shell cocotb-config --makefiles)/Makefile.sim

#--------------------------------------------------
# NPU_V1 FILES
#--------------------------------------------------

NPU_SRC_DIR := ../rtl/soc/npu_v1/src

NPU_DATAPATH_FILES := \
	$(NPU_SRC_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_SRC_DIR)/PSC_NPU_Mul4.sv \
	$(NPU_SRC_DIR)/PSC_NPU_AccBank.sv

NPU_V1_RTL_FILES := \
	$(NPU_SRC_DIR)/PSC_NPU_Controller.v \
	$(NPU_SRC_DIR)/PSC_NPU_ReadController.v \
	$(NPU_SRC_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_DATAPATH_FILES)

NPU_V2_DIR := ../rtl/soc/npu_v2/src

# NPU V2: selector 8 lanes, two signed power-of-two terms per weight byte.
NPU_V2_FILES = \
	$(NPU_V2_DIR)/PSC_NPU_Controller.v \
	$(NPU_V2_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V2_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V2_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V2_DIR)/PSC_NPU_PotLanes.sv \
	$(NPU_V2_DIR)/PSC_NPU_AccBank.sv

#--------------------------------------------------
# NPU legacy FILES
#--------------------------------------------------

LEGACY_SRC_DIR := ../rtl/soc/npu/src

# Preserve the standalone legacy PE and 2x2 tests, including atomic commit.
PE_FILE = $(LEGACY_SRC_DIR)/PSC_NPU_PE_INT.sv \
          $(LEGACY_SRC_DIR)/PSC_NPU_PE_Mult.sv \
          $(LEGACY_SRC_DIR)/PSC_NPU_PE_SimTop.v

VERILOG_FILE_SA_2x2 = $(LEGACY_SRC_DIR)/PSC_NPU_SystolicArray2x2.v $(PE_FILE)
VERILOG_FILE_SA_4x4 = $(LEGACY_SRC_DIR)/PSC_NPU_SystolicArray4x4.v $(PE_FILE)
NPU_CTRL_FILE 	    = $(LEGACY_SRC_DIR)/PSC_NPU_Controller.v \
	                  $(LEGACY_SRC_DIR)/PSC_NPU_ReadController.v

NPU_RTL_FILES		= $(NPU_CTRL_FILE) $(VERILOG_FILE_SA_4x4)

# ============================================================
# NPUコアの切り替え（v1 / v2 / legacy）
# ============================================================
# デフォルトはV1
NPU_VERSION ?= v1

ifeq ($(NPU_VERSION),v1)
VERILOG_FILE_CTRL = $(NPU_V1_RTL_FILES)
else ifeq ($(NPU_VERSION),v2)
VERILOG_FILE_CTRL = $(NPU_V2_FILES)
else ifeq ($(NPU_VERSION),legacy)
VERILOG_FILE_CTRL = $(NPU_RTL_FILES)
else
$(error NPU_VERSION=$(NPU_VERSION) は不正です。v1 / v2 / legacy を指定してください)
endif

#--------------------------------------------------
# Cocotb Files
#--------------------------------------------------

COCOTB_FILE_SA_Ctrl		= int8_SA_Ctrl_test
COCOTB_FILE_SA 			= int8_SA_test
COCOTB_FILE_SA_4x4		= int8_SA_4x4_test
COCOTB_FILE_PE 			= int8_PE_test

COCOTB_CTRL_MODULE = cocotb_tb.npu.$(COCOTB_FILE_SA_Ctrl)
COCOTB_SA4_MODULE = cocotb_tb.npu.$(COCOTB_FILE_SA_4x4)
SA4_TOP = PSC_NPU_SystolicArray4x4
SA4_FILES = $(VERILOG_FILE_SA_4x4)

COCOTB_CFG       := $(shell which cocotb-config)
COCOTB_MAKEFILE  := $(shell cocotb-config --makefiles)/Makefile.sim
SIM_BUILD        ?= $(if $(filter v2,$(NPU_VERSION)),sim_build/npu_v2,sim_build)

# v2 weight bytes are PoT codes, so use its matching arithmetic scoreboards.
NPU_V2_BASE := $(abspath $(NPU_V2_DIR)/..)
NPU_V2_MODEL_BUILD = $(abspath $(SIM_BUILD))/model_reference
PYTHON ?= python3
ifeq ($(NPU_VERSION),v2)
COCOTB_CTRL_MODULE = controller_test
COCOTB_SA4_MODULE = core_test
SA4_TOP = CoreTop
SA4_FILES = $(NPU_V2_FILES) $(NPU_V2_BASE)/tests/CoreTop.sv
export PYTHONPATH := $(NPU_V2_BASE)/tests:$(NPU_V2_BASE)/reference:$(CURDIR):$(PYTHONPATH)
export LANES := 8
export MODEL_VECTORS = $(NPU_V2_MODEL_BUILD)/rtl_vectors.json
endif

#--------------------------------------------------
# Targets
#--------------------------------------------------
.PHONY: simulate_all simulate_PE simulate_SA_2x2 simulate_SA_4x4 simulate_SA_Ctrl simulate_SA_multicycle_Ctrl

# まとめて実行
simulate_all: simulate_PE simulate_SA_2x2 simulate_SA_4x4 simulate_SA_Ctrl simulate_SA_multicycle_Ctrl
		
# Output Stationary.
simulate_SA_Ctrl: 
	@echo "[SIM] MODE=$(MODE), SIM=$(SIM)"
	@mkdir -p $(abspath $(SIM_BUILD))/simulate_SA_Ctrl
	NPU_CYCLE_RESULTS="$(abspath $(SIM_BUILD))/simulate_SA_Ctrl/cycles.json" \
	$(SIM_ARG_NAME)="$(SIM_ARGS) -DDUMP_VCD_CTRL=1" \
	$(MAKE) -f $(COCOTB_MAKEFILE) \
	    SIM=$(SIM) \
	    SIM_BUILD=$(SIM_BUILD)/$@ \
	    COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/$@/results.xml \
	    COCOTB_TEST_MODULES=$(COCOTB_CTRL_MODULE) \
	    TOPLEVEL=PSC_NPU_Controller \
	    TOPLEVEL_LANG=verilog \
	    VERILOG_SOURCES="$(VERILOG_FILE_CTRL)"

# Output Stationary.
simulate_SA_2x2:
	@echo "[SIM] MODE=$(MODE), SIM=$(SIM)"
	$(SIM_ARG_NAME)="$(SIM_ARGS) -DDUMP_VCD_SA=1" \
	$(MAKE) -f $(COCOTB_MAKEFILE) \
	    SIM=$(SIM) \
	    SIM_BUILD=$(SIM_BUILD)/$@ \
	    COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/$@/results.xml \
	    COCOTB_TEST_MODULES=cocotb_tb.npu.$(COCOTB_FILE_SA) \
	    TOPLEVEL=PSC_NPU_SystolicArray2x2 \
	    TOPLEVEL_LANG=verilog \
	    VERILOG_SOURCES="$(VERILOG_FILE_SA_2x2)"

# Output Stationary.
simulate_SA_4x4:
	@echo "[SIM] MODE=$(MODE), SIM=$(SIM)"
	$(SIM_ARG_NAME)="$(SIM_ARGS) -DDUMP_VCD_SA=1" \
	$(MAKE) -f $(COCOTB_MAKEFILE) \
	    SIM=$(SIM) \
	    SIM_BUILD=$(SIM_BUILD)/$@ \
	    COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/$@/results.xml \
	    COCOTB_TEST_MODULES=$(COCOTB_SA4_MODULE) \
	    TOPLEVEL=$(SA4_TOP) \
	    TOPLEVEL_LANG=verilog \
	    VERILOG_SOURCES="$(SA4_FILES)"

simulate_PE:
	$(SIM_ARG_NAME)="$(SIM_ARGS) -DDUMP_VCD_PE=1" \
	$(MAKE) -f $(COCOTB_MAKEFILE) \
	    SIM=$(SIM) \
	    SIM_BUILD=$(SIM_BUILD)/$@ \
	    COCOTB_RESULTS_FILE=$(abspath $(SIM_BUILD))/$@/results.xml \
	    COCOTB_TEST_MODULES=cocotb_tb.npu.$(COCOTB_FILE_PE) \
	    TOPLEVEL=PSC_NPU_PE_SimTop \
	    TOPLEVEL_LANG=verilog \
	    VERILOG_SOURCES="$(PE_FILE)"

# Preserve the original one-MUL regression on the unmodified legacy NPU.
# The v1 production design always has four multipliers.
simulate_SA_multicycle_Ctrl:
	$(MAKE) -f Makefile.npu NPU_VERSION=legacy \
	    simulate_SA_Ctrl \
	    SIM_BUILD=$(SIM_BUILD)/$@ \
	    $(if $(filter icarus,$(SIM)), \
	        COMPILE_ARGS="$(SIM_ARGS) -g2012 -PPSC_NPU_Controller.MUL_NUM=1", \
	        EXTRA_ARGS="$(SIM_ARGS) -GMUL_NUM=1")
			
#--------------------------------------------------
# Yosys
#--------------------------------------------------

YOSYS ?= yosys

YOSYS_OUT_DIR := ../rtl/soc/npu/yosys_out

YOSYS_TOP_SAT_2x2 := PSC_NPU_SystolicArray2x2
YOSYS_LOG_SAT_2x2 := $(YOSYS_OUT_DIR)/sa_2x2.log
YOSYS_JSON_SAT_2x2 := $(YOSYS_OUT_DIR)/sa_2x2.json

# Output Stationary
yosys_SA_2x2:
	@echo "========================================"
	@echo "[YOSYS] TOP=$(YOSYS_TOP_SAT_2x2)"
	@echo "[YOSYS] PE=4, MUL=2"
	@echo "========================================"
	@mkdir -p $(YOSYS_OUT_DIR)
	$(YOSYS) -l $(YOSYS_LOG_SAT_2x2) -p " \
		read_verilog -sv $(VERILOG_FILE_SA_2x2); \
		hierarchy -check -top $(YOSYS_TOP_SAT_2x2); \
		proc; \
		opt; \
		flatten; \
		opt; \
		memory; \
		opt; \
		techmap; \
		opt; \
		stat -top $(YOSYS_TOP_SAT_2x2); \
		write_json $(YOSYS_JSON_SAT_2x2); \
	"

yosys_clean:
	rm -rf $(YOSYS_OUT_DIR)

# Isolated old/new regressions plus streaming, snapshot and cycle scoreboards.
.PHONY: validate_streaming
ifeq ($(NPU_VERSION),v2)
# Like the original validate_streaming runner, this full suite uses Icarus.
# Direct simulate_SA_Ctrl / simulate_SA_4x4 targets honor MODE.
.PHONY: npu_v2_model_reference
npu_v2_model_reference:
	$(PYTHON) $(NPU_V2_BASE)/reference/evaluate_model.py \
	    --build $(NPU_V2_MODEL_BUILD) \
	    --output $(NPU_V2_MODEL_BUILD)/results

simulate_SA_4x4: npu_v2_model_reference

validate_streaming: npu_v2_model_reference
	$(PYTHON) $(NPU_V2_BASE)/tests/run.py \
	    --build $(abspath $(SIM_BUILD))/validate_streaming \
	    --vectors $(NPU_V2_MODEL_BUILD)/rtl_vectors.json --lanes 8
else
validate_streaming:
	python3 cocotb_tb/npu/run_streaming_validation.py \
	    --src $(abspath $(if $(filter legacy,$(NPU_VERSION)),$(LEGACY_SRC_DIR),$(NPU_SRC_DIR))) \
	    --build $(abspath $(SIM_BUILD))/validate_streaming \
	    $(if $(filter legacy,$(NPU_VERSION)),--baseline)
endif
