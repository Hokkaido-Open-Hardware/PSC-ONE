# Rust PSC-OS RV64: Rust BIOS/loader -> KERNEL.MEM -> USER.MEM on PSC_RV64.
#   make -f Makefile.pscos.rust.rv64 simulate_SD_PSCOS_RV64
#   make -f Makefile.pscos.rust.rv64 smoke_sd
#   make -f Makefile.pscos.rust.rv64 simulate_SD_PSCOS_RV64 SIM_LEVEL=GATE
# Run files stay under build/pscos-rust; the C simulation's mem/ is not overwritten.
# ============================================================
# Default target and configuration
# ============================================================

.DEFAULT_GOAL := simulate_SD_PSCOS_RV64
CPU_VERSION := rv64
BOARD := psc_one_rv64
ifneq ($(CPU_VERSION):$(BOARD),rv64:psc_one_rv64)
$(error This Makefile requires CPU_VERSION=rv64 BOARD=psc_one_rv64)
endif
RUST_SIM_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
# Standalone RV64 configuration: do not include the RV32/C OS Makefile.
MODE ?= verilator
# Simulation level is separate from the simulator backend.
# Keep older MODE=GATE invocations compatible.
SIM_LEVEL ?= $(if $(filter GATE,$(MODE)),GATE,RTL)
ifeq ($(filter $(SIM_LEVEL),RTL GATE),)
$(error Unsupported SIM_LEVEL=$(SIM_LEVEL); use RTL or GATE)
endif
SIM_FAST ?= $(if $(filter 1,$(DUMP_FST)),0,1)
ifeq ($(SIM_LEVEL),RTL)
ifneq ($(MODE),verilator)
$(error Rust PSC-OS RTL simulation requires MODE=verilator)
endif
endif
# ============================================================
# RTL simulator configuration
# ============================================================

ifeq ($(MODE),verilator)
PSCONE_TOP := PSC_ONE_Chip_sim
TOP_COMPILE_ARGS := -DTOP_SIM -DCPU_RV64
ifeq ($(DUMP_FST),1)
VCD_COMPILE_ARGS := -DDUMP_FST
endif
EXTRA_ARGS := -O3 --Wno-ASCRANGE --Wno-INITIALDLY --Wno-COMBDLY \
	--Wno-WIDTHEXPAND --Wno-WIDTHTRUNC --Wno-REALCVT --Wno-MULTIDRIVEN
ifeq ($(SIM_FAST),1)
EXTRA_ARGS += --bbox-sys --x-assign fast --x-initial fast
else
EXTRA_ARGS += --trace --trace-fst
endif
# The existing RV64 wrapper leaves the legacy NPU's status_extra output open.
# Suppress only this warning; Verilator does not support -Wno-error-<warning>.
# Other warnings still fail.
EXTRA_ARGS += -Wno-PINMISSING
endif
COCOTB_MAKEFILE := $(shell cocotb-config --makefiles)/Makefile.sim
RTL_DIR := $(abspath $(RUST_SIM_DIR)/../rtl)

# ============================================================
# NPU implementation selection (v1 / v2 / legacy)
# ============================================================

NPU_VERSION ?= legacy

NPU_LEGACY_DIR = $(RTL_DIR)/soc/npu/src
NPU_V1_DIR     = $(RTL_DIR)/soc/npu_v1/src
NPU_V2_DIR     = $(RTL_DIR)/soc/npu_v2/src

# NPU V1: 4 MUL -> 4 fixed WB lanes -> 16 ACC bank
NPU_V1_FILES = \
	$(NPU_V1_DIR)/PSC_NPU_Controller.v \
	$(NPU_V1_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V1_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V1_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V1_DIR)/PSC_NPU_Mul4.sv \
	$(NPU_V1_DIR)/PSC_NPU_AccBank.sv

# NPU V2: selector 8 lanes, two signed power-of-two terms per weight byte.
NPU_V2_FILES = \
	$(NPU_V2_DIR)/PSC_NPU_Controller.v \
	$(NPU_V2_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V2_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V2_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V2_DIR)/PSC_NPU_PotLanes.sv \
	$(NPU_V2_DIR)/PSC_NPU_AccBank.sv

# Legacy NPU
NPU_LEGACY_FILES = \
	$(NPU_LEGACY_DIR)/PSC_NPU_Controller.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_Engine.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_Requantize.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_TilePost.sv \
	$(NPU_LEGACY_DIR)/PSC_LPU_Controller.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_ReadController.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_INT.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_Mult.sv

ifeq ($(NPU_VERSION),v1)
SA_DIR  = $(NPU_V1_DIR)
SA_FILE = $(NPU_V1_FILES)
else ifeq ($(NPU_VERSION),v2)
SA_DIR  = $(NPU_V2_DIR)
SA_FILE = $(NPU_V2_FILES)
else ifeq ($(NPU_VERSION),legacy)
SA_DIR  = $(NPU_LEGACY_DIR)
SA_FILE = $(NPU_LEGACY_FILES)
else
$(error NPU_VERSION=$(NPU_VERSION) は不正です。v1 / v2 / legacy を指定してください)
endif

# ============================================================
# RTL source files and simulation models
# ============================================================

# PSC_RV64, SoC, caches, peripherals, and simulation models.
RUST_RTL_SOURCES := \
	$(RTL_DIR)/tang20k/top/PSC_ONE_Chip_sim.v \
	$(RTL_DIR)/tang20k/top/PSC_ONE_Chip.v \
	$(RTL_DIR)/soc/soc_top/PSC_ONE_SOC.v \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_Types.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_RV64_core.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_RV64_FetchUnit.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_FetchPredict.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Fetch_Fifo.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Fetch.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_RV64_InstructionEngine.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_InstructionUnit.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Decorder.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Execute.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Execute_ByteALU.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Execute_Divider.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Execute_Mul.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Branch.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/MemoryStore.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_Register.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_PC.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/MMU.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/Csr.sv \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_RV64_Monitor.v \
	$(RTL_DIR)/soc/cpu_rv64/src/PSC_ONE_RV64_core.v \
	$(RTL_DIR)/soc/mmio/MMIO/PSC_RV32IS_MMapped_IO.v \
	$(RTL_DIR)/soc/mmio/UART/PSC_RV32IS_UART.v \
	$(RTL_DIR)/soc/mmio/I2C/PSC_I2C_capture.sv \
	$(RTL_DIR)/soc/mmio/I2C/PSC_RV32_I2C.sv \
	$(RTL_DIR)/soc/mmio/LED/PSC_RV32IS_LED.v \
	$(RTL_DIR)/soc/cache/src/cache_dma_controller.sv \
	$(RTL_DIR)/soc/cache/src/cache_dma_controller_io.sv \
	$(RTL_DIR)/soc/cache/src/dm_cache_data.v \
	$(RTL_DIR)/soc/cache/src/dm_cache_tag.v \
	$(RTL_DIR)/tang20k/top/Delay_N.v \
	$(RTL_DIR)/soc/axi/PSC_RV32_CacheAXI.v \
	$(RTL_DIR)/soc/axi/PSC_RV64_CacheAXI.sv \
	$(RTL_DIR)/tang20k/sdram_controller/sdram_axi_controller.v \
	$(RTL_DIR)/tang20k/sdram_controller/sdram_controller.sv \
	$(RTL_DIR)/model/SDRAM_model/GW2AR_sdram_verilator.v \
	$(RTL_DIR)/soc/boot/PSC_ONE_Boot_axi.v \
	$(RTL_DIR)/soc/dma/PSC_ONE_DMA_axi.v \
	$(RTL_DIR)/soc/mmio/LCD/PSC_ONE_LCD.v \
	$(RTL_DIR)/soc/mmio/LCD/tft_clock_divider.v \
	$(RTL_DIR)/soc/mmio/LCD/tft_ili9488.v \
	$(RTL_DIR)/soc/mmio/LCD/tft_ili9488_spi.v \
	$(RTL_DIR)/soc/mmio/PSC_SDCARD/src/PSC_SDCard.sv \
	$(RTL_DIR)/soc/mmio/PSC_SDCARD/src/PSC_SDCard_SPI.sv \
	$(RTL_DIR)/soc/mmio/TIMER/PSC_RV32IS_TIMER.v \
	$(RTL_DIR)/soc/mmio/I2S_RX/PSC_I2SRX.sv \
	$(RTL_DIR)/model/I2S_MIC_MODEL/PSC_I2S_MIC_MODEL.v \
	$(RTL_DIR)/model/LCD_model/PSC_LCD_ILI9488_MODEL.v \
	$(RTL_DIR)/soc/pfe/src/PSC_PFE.v \
	$(RTL_DIR)/model/SDCARD_model/sdcard_spi_model.v \
	$(SA_FILE)

# ============================================================
# Rust firmware and simulation output
# ============================================================

RUST_OS_DIR := $(abspath $(RUST_SIM_DIR)/../../software/os_rust)
RUST_OS_BUILD := $(RUST_OS_DIR)/build/psc_one_rv64
ifneq ($(filter-out sd,$(RUST_BOOT)),)
$(error RUST_BOOT=rtl is removed; Rust simulation always boots from SD)
endif
RUST_RUN_DIR ?= $(RUST_SIM_DIR)/build/pscos-rust/$(if $(filter GATE,$(SIM_LEVEL)),gate_rv64,sd_$(CPU_VERSION)_$(NPU_VERSION)_$(SIM_FAST))
RUST_SIM_BUILD := $(RUST_RUN_DIR)/sim_build
RUST_VDEF := -DFST_UART_MODE -DPSCOS_SIM -DFPGA_BOOT_LOADER_MODE

# ============================================================
# Gowin gate simulation configuration
# ============================================================

ifeq ($(SIM_LEVEL),GATE)
# Functional post-synthesis simulation. CPU/ROM/NPU configuration is baked
# into the netlist; RTL defines and staged boot ROMs cannot change it.
GATE_NETLIST ?= $(HOME)/Program/Gowin/PSC-ONE_RV64/impl/gwsynthesis/PSC-ONE_RV64.vg
GOWIN_SIMLIB ?= /opt/gowin/IDE/simlib/gw2a/prim_sim.v
GATE_CLOCK_PERIOD_NS ?= 37.038
# Current netlist: 81 MHz PLL, UART divider floor(80 MHz / 115200) = 694.
GATE_UART_BIT_NS ?= 8568
# Model-only workaround verified with the RV32 gate controller: keep data
# stable through the +4.630 ns sample. Original model tOH is 3.0 ns.
GATE_SDRAM_TAC_NS ?= 5.4
GATE_SDRAM_TOH_NS ?= 5.0
GATE_SDRAM_INIT_ZERO ?= 1
GATE_SOURCES := $(abspath $(GATE_NETLIST)) $(abspath $(GOWIN_SIMLIB)) \
	$(RUST_SIM_DIR)/testbench/PSC_ONE_Chip_gate_sim.sv \
	$(RTL_DIR)/model/SDRAM_model/GW2AR_sdram.v \
	$(RTL_DIR)/model/SDCARD_model/sdcard_spi_model.v
GATE_COMPILE_ARGS := -g2012 \
	-PPSC_ONE_Chip_gate_sim.CLOCK_PERIOD_NS=$(GATE_CLOCK_PERIOD_NS) \
	-PPSC_ONE_Chip_gate_sim.SDRAM_TAC_NS=$(GATE_SDRAM_TAC_NS) \
	-PPSC_ONE_Chip_gate_sim.SDRAM_TOH_NS=$(GATE_SDRAM_TOH_NS)
ifeq ($(GATE_SDRAM_INIT_ZERO),1)
GATE_COMPILE_ARGS += -DINIT_CLEAR_MEM_BANKS
endif
ifeq ($(DUMP_FST),1)
GATE_COMPILE_ARGS += -DDUMP_FST
GATE_PLUSARGS := -fst
endif

# ============================================================
# Gate input validation and compilation
# ============================================================

.PHONY: check_gate_inputs gate_config compile_gate
check_gate_inputs:
	@test -r "$(GATE_NETLIST)" || { echo "Missing GATE_NETLIST: $(GATE_NETLIST)"; exit 1; }
	@test -r "$(GOWIN_SIMLIB)" || { echo "Missing GOWIN_SIMLIB: $(GOWIN_SIMLIB)"; exit 1; }
	@command -v iverilog >/dev/null && command -v vvp >/dev/null

prepare_rust: check_gate_inputs
run_rust: gate_config
# Source selection and compiler options are not automatically tracked by the
# cocotb Makefile. Preserve the stamp when unchanged, rebuild when they change.
gate_config: check_gate_inputs
	@python3 -c 'from pathlib import Path; import sys; p=Path(sys.argv[1]); s="\n".join(sys.argv[2:])+"\n"; p.parent.mkdir(parents=True,exist_ok=True); p.write_text(s) if not p.exists() or p.read_text()!=s else None' "$(RUST_SIM_BUILD)/gate.config" "$(GATE_SOURCES)" "$(GATE_COMPILE_ARGS)"

# Compile without building firmware or starting a potentially long OS boot.
compile_gate: check_gate_inputs
	mkdir -p $(RUST_SIM_BUILD)
	iverilog -s PSC_ONE_Chip_gate_sim $(GATE_COMPILE_ARGS) -o $(RUST_SIM_BUILD)/gate_compile.vvp $(GATE_SOURCES)
endif

# ============================================================
# SD boot simulation targets
# ============================================================

.PHONY: simulate_SD_PSCOS_RV64 smoke_sd prepare_rust
simulate_SD_PSCOS_RV64: prepare_rust
	$(MAKE) -f $(RUST_SIM_DIR)/Makefile.pscos.rust.rv64 run_rust

# ============================================================
# SD boot smoke test
# ============================================================

smoke_sd: export PSC_UART_GUI = 0
smoke_sd: export PSC_UART_INTERACTIVE = 0
smoke_sd: export PSC_UART_AUTO_PROMPT = 0
smoke_sd: export PSC_OS_STOP_AFTER_BOOT = 1
smoke_sd: export RUN_CYCLES = 1500000000
smoke_sd: simulate_SD_PSCOS_RV64

# ============================================================
# Firmware and SD card image preparation
# ============================================================

prepare_rust:
	$(MAKE) -C $(RUST_OS_DIR) CPU_VERSION=$(CPU_VERSION) BOARD=$(BOARD) BUILD=$(RUST_OS_BUILD) all
	python3 $(RUST_SIM_DIR)/python_tool/prepare_pscos_rust.py --os $(RUST_OS_DIR) --build $(RUST_OS_BUILD) --bootrom $(RUST_OS_BUILD)/bootrom.mem --bootloader $(RUST_OS_BUILD)/bootloader_fat32.mem --run $(RUST_RUN_DIR)
	$(MAKE) -C $(RUST_SIM_DIR) -f Makefile.sdcard INPUT_DIR=$(RUST_RUN_DIR)/mem SDCARD_DIR=$(RUST_RUN_DIR)/sdcard all
	cp $(RUST_OS_BUILD)/kernel.elf $(RUST_RUN_DIR)/kernel.elf
	cp $(RUST_OS_BUILD)/image_layout.h $(RUST_RUN_DIR)/image_layout.h

# ============================================================
# Simulation execution (RTL / GATE)
# ============================================================

.PHONY: run_rust
run_rust:
ifeq ($(SIM_LEVEL),GATE)
	@echo "[Rust PSC-OS GATE] netlist=$(GATE_NETLIST) run=$(RUST_RUN_DIR)"
	@echo "[Rust PSC-OS GATE] CPU/ROM/NPU and UART divider come from the netlist (no RTL overrides)."
	@echo "[Rust PSC-OS GATE] SDRAM model: tAC=$(GATE_SDRAM_TAC_NS) ns, tOH=$(GATE_SDRAM_TOH_NS) ns, initial zero=$(GATE_SDRAM_INIT_ZERO)"
	cd $(RUST_RUN_DIR) && \
	PYTHONPATH=$(RUST_SIM_DIR):$(PYTHONPATH) \
	COCOTB_TEST_MODULES=cocotb_tb.psc_os.test_gate_rv64 \
	PSC_OS_BOOT_MARKER='PSC_OS>' \
	UART_BIT_NS=$(GATE_UART_BIT_NS) \
	GATE_CLOCK_PERIOD_NS=$(GATE_CLOCK_PERIOD_NS) \
	COCOTB_RESULTS_FILE=$(RUST_SIM_BUILD)/results.xml \
	PSC_UART_LOGFILE=$(RUST_RUN_DIR)/log_uart/uart.log \
	TOPLEVEL=PSC_ONE_Chip_gate_sim TOPLEVEL_LANG=verilog \
	SIM=icarus SIM_BUILD=$(RUST_SIM_BUILD) \
	VERILOG_SOURCES="$(GATE_SOURCES)" \
	CUSTOM_COMPILE_DEPS="$(RUST_SIM_BUILD)/gate.config" \
	COMPILE_ARGS="$(GATE_COMPILE_ARGS)" \
	EXTRA_ARGS= SIM_ARGS= COCOTB_PLUSARGS="$(GATE_PLUSARGS)" \
	$(MAKE) --silent -f $(COCOTB_MAKEFILE)
else
	@echo "[Rust PSC-OS] CPU=$(CPU_VERSION) NPU=$(NPU_VERSION) run=$(RUST_RUN_DIR)"
	cd $(RUST_RUN_DIR) && \
	PYTHONPATH=$(RUST_SIM_DIR):$(PYTHONPATH) \
	MODULE=cocotb_tb.psc_os.PSCONE_os_test \
	PSC_OS_KERNEL_ELF=$(RUST_RUN_DIR)/kernel.elf \
	PSC_OS_BOOT_MARKER='PSC_OS>' \
	COCOTB_RESULTS_FILE=$(RUST_SIM_BUILD)/results.xml \
	PSC_UART_LOGFILE=$(RUST_RUN_DIR)/log_uart/uart.log \
	EXPECTED_RESULT=0xff00ff1b \
	TOPLEVEL=$(PSCONE_TOP) TOPLEVEL_LANG=verilog \
	SIM=verilator SIM_BUILD=$(RUST_SIM_BUILD) \
	VERILOG_SOURCES="$(RUST_RTL_SOURCES)" \
	COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS) $(RUST_VDEF)" \
	EXTRA_ARGS="$(EXTRA_ARGS)" \
	$(MAKE) --silent -f $(COCOTB_MAKEFILE)
endif
