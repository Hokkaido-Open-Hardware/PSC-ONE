	rv32ui-add:RV32ISP_riscv_test:./riscv_build/rv32ui-add.mem:0x00000001:0x00001000 \
	rv32ui-addi:RV32ISP_riscv_test:./riscv_build/rv32ui-addi.mem:0x00000001:0x00001000 \
	rv32ui-and:RV32ISP_riscv_test:./riscv_build/rv32ui-and.mem:0x00000001:0x00001000 \
	rv32ui-andi:RV32ISP_riscv_test:./riscv_build/rv32ui-andi.mem:0x00000001:0x00001000 \
	rv32ui-auipc:RV32ISP_riscv_test:./riscv_build/rv32ui-auipc.mem:0x00000001:0x00001000 \
	rv32ui-lb:RV32ISP_riscv_test:./riscv_build/rv32ui-lb.mem:0x00000001:0x00001000 \
	rv32ui-lbu:RV32ISP_riscv_test:./riscv_build/rv32ui-lbu.mem:0x00000001:0x00001000 \
	rv32ui-lh:RV32ISP_riscv_test:./riscv_build/rv32ui-lh.mem:0x00000001:0x00001000 \
	rv32ui-lhu:RV32ISP_riscv_test:./riscv_build/rv32ui-lhu.mem:0x00000001:0x00001000 \
	rv32ui-lui:RV32ISP_riscv_test:./riscv_build/rv32ui-lui.mem:0x00000001:0x00001000 \
	rv32ui-lw:RV32ISP_riscv_test:./riscv_build/rv32ui-lw.mem:0x00000001:0x00001000 \
	rv32ui-sb:RV32ISP_riscv_test:./riscv_build/rv32ui-sb.mem:0x00000001:0x00001000 \
	rv32ui-sh:RV32ISP_riscv_test:./riscv_build/rv32ui-sh.mem:0x00000001:0x00001000 \
	rv32ui-fence_i:RV32ISP_riscv_test:./riscv_build/rv32ui-fence_i.mem:0x00000001:0x00001000 \
	rv32ui-beq:RV32ISP_riscv_test:./riscv_build/rv32ui-beq.mem:0x00000001:0x00001000 \
	rv32ui-bge:RV32ISP_riscv_test:./riscv_build/rv32ui-bge.mem:0x00000001:0x00001000 \
	rv32ui-bgeu:RV32ISP_riscv_test:./riscv_build/rv32ui-bgeu.mem:0x00000001:0x00001000 \
	rv32ui-blt:RV32ISP_riscv_test:./riscv_build/rv32ui-blt.mem:0x00000001:0x00001000 \
