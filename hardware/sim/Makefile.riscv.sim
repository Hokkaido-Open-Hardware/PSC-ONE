	rv32ui-xori:RV32ISP_riscv_test:./riscv_build/rv32ui-xori.mem:0x00000001:0x00001000 \
	rv32um-div:RV32ISP_riscv_test:./riscv_build/rv32um-div.mem:0x00000001:0x00001000 \
	rv32um-divu:RV32ISP_riscv_test:./riscv_build/rv32um-divu.mem:0x00000001:0x00001000 \
	rv32um-mul:RV32ISP_riscv_test:./riscv_build/rv32um-mul.mem:0x00000001:0x00001000 \
	rv32um-mulh:RV32ISP_riscv_test:./riscv_build/rv32um-mulh.mem:0x00000001:0x00001000 \
	rv32um-mulhsu:RV32ISP_riscv_test:./riscv_build/rv32um-mulhsu.mem:0x00000001:0x00001000 \
	rv32um-mulhu:RV32ISP_riscv_test:./riscv_build/rv32um-mulhu.mem:0x00000001:0x00001000 \
	rv32um-rem:RV32ISP_riscv_test:./riscv_build/rv32um-rem.mem:0x00000001:0x00001000 \
	rv32um-remu:RV32ISP_riscv_test:./riscv_build/rv32um-remu.mem:0x00000001:0x00001000 \
	rv32ui-ld_st:RV32ISP_riscv_test:./riscv_build/rv32ui-ld_st.mem:0x00000001:0x00002000 \

# 非アラインアクセス試験のため除外
#rv32ui-ma_data:RV32ISP_riscv_test:./riscv_build/rv32ui-ma_data.mem:0x00000001 \

# ============================================================
# テストプログラムの切り替え（basic / single）
# ============================================================
# デフォルトはbasic
TEST_PROGRAM_LIST ?= basic

ifeq ($(TEST_PROGRAM_LIST),basic)
RV32ISP_TEST = $(RISCV_BASIC_TEST)
else ifeq ($(TEST_PROGRAM_LIST),single)
RV32ISP_TEST = $(RISCV_SINGLE_TEST)
else
$(error TEST_PROGRAM_LIST=$(TEST_PROGRAM_LIST) は不正です。basic または long, single を指定してください)
endif

# run test
.PHONY: simulate_RISCV_TESTS
simulate_RISCV_TESTS:
	$(MAKE) -f Makefile.riscv all
	@echo "MODE=$(MODE)"
	@echo "SIM=$(SIM)"
	@echo "CPU_VERSION=$(CPU_VERSION)"
	@echo "TEST_PROGRAM_LIST=$(TEST_PROGRAM_LIST)"
	@echo "TOP_COMPILE_ARGS=$(TOP_COMPILE_ARGS)"
	@echo "COMPILE_ARGS=$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS)"
	@mkdir -p ./wave
	@set -e; \
	for t in $(RV32ISP_TEST); do \
		name=$$(echo $$t | cut -d: -f1); \
		cocotb_file=$$(echo $$t | cut -d: -f2); \
		mem_file=$$(echo $$t | cut -d: -f3); \
		expected=$$(echo $$t | cut -d: -f4); \
		tohost_addr=$$(echo $$t | cut -d: -f5); \
		echo "========================================"; \
		echo "[TEST] $$name"; \
		echo "[MEM ] $$mem_file"; \
		echo "[EXP ] $$expected"; \
		echo "========================================"; \
		$(MAKE) clean; \
		tmp=$$(mktemp); \
		head -n 4096 "$$mem_file" > $$tmp; \
		cp $$tmp ./mem/test_program.mem; \
		rm -f $$tmp; \
		COCOTB_TEST_MODULES=cocotb_tb.cpu.$$cocotb_file \
		TOHOST_ADDR="$$tohost_addr" \
		EXPECTED_RESULT=$$expected \
		TOPLEVEL=$(CPU_TOP) TOPLEVEL_LANG=verilog \
		SIM=$(SIM) \
		VERILOG_SOURCES="$(INPUT_CPU_CORE_SIM_FILE)" \
		COMPILE_ARGS="$(TOP_COMPILE_ARGS) $(VCD_COMPILE_ARGS)" \
		EXTRA_ARGS="$(EXTRA_ARGS) $(VDEF)" \
		make --silent -f $(COCOTB_MAKEFILE); \
	done
	