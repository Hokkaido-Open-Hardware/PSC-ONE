	rv32ui-bne:RV32ISP_riscv_test:./riscv_build/rv32ui-bne.mem:0x00000001:0x00001000 \
	rv32ui-jal:RV32ISP_riscv_test:./riscv_build/rv32ui-jal.mem:0x00000001:0x00001000 \
	rv32ui-jalr:RV32ISP_riscv_test:./riscv_build/rv32ui-jalr.mem:0x00000001:0x00001000 \
	rv32ui-or:RV32ISP_riscv_test:./riscv_build/rv32ui-or.mem:0x00000001:0x00001000 \
	rv32ui-ori:RV32ISP_riscv_test:./riscv_build/rv32ui-ori.mem:0x00000001:0x00001000 \
	rv32ui-simple:RV32ISP_riscv_test:./riscv_build/rv32ui-simple.mem:0x00000001:0x00001000 \
