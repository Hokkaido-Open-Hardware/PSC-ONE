# ============================================================
# RISC-V official ISA test bulk build
# ============================================================

RISCV_GCC     ?= riscv64-unknown-elf-gcc
RISCV_OBJDUMP ?= riscv64-unknown-elf-objdump
RISCV_OBJCOPY ?= riscv64-unknown-elf-objcopy

RISCV_TEST_ROOT := riscv_tests
RISCV_BUILD_DIR := riscv_build

RISCV_LINKER_SCRIPT := riscv/link_psc.ld

# ISA is also passed explicitly by Makefile.riscv.sim. Keep TEST_GROUPS as
# a backwards-compatible spelling when ISA is not supplied.
ISA ?= $(or $(TEST_GROUPS),rv32ui rv32um)
override ISA := $(strip $(ISA))
ifneq ($(filter-out rv32ui rv32um rv64ui,$(ISA)),)
$(error Unsupported ISA=$(ISA); use rv32ui rv32um or rv64ui)
endif
ifeq ($(ISA),)
$(error ISA must not be empty)
endif
ifneq ($(filter rv64ui,$(ISA)),)
ifneq ($(filter rv32%,$(ISA)),)
$(error Cannot mix RV32 and RV64 test groups in one build)
endif
RISCV_XLEN := 64
RISCV_ABI := lp64
else
RISCV_XLEN := 32
RISCV_ABI := ilp32
endif
ABI ?= $(RISCV_ABI)
ifneq ($(ABI),$(RISCV_ABI))
$(error ISA=$(ISA) requires ABI=$(RISCV_ABI), got $(ABI))
endif
override TEST_GROUPS := $(ISA)
# Separate the p environment and XLEN/ABI from the old flat build directory.
RISCV_OUTPUT_DIR := $(RISCV_BUILD_DIR)/rv$(RISCV_XLEN)-$(ABI)-p

# ============================================================
# Build target groups
#
# rv32ui : RV32I integer instructions
# rv32um : RV32M multiply/divide instructions
# rv64ui : RV64I integer instructions (lp64, bare-metal p environment)
#
# Example:
#   make -f Makefile.riscv TEST_GROUPS="rv32ui"
#   make -f Makefile.riscv TEST_GROUPS="rv32ui rv32um"
#   make -f Makefile.riscv ISA=rv64ui
# ============================================================

# ============================================================
# Source discovery
# ============================================================

TEST_SOURCES := $(foreach group,$(TEST_GROUPS), \
	$(wildcard $(RISCV_TEST_ROOT)/isa/$(group)/*.S))

TEST_NAMES := $(foreach source,$(TEST_SOURCES), \
	$(notdir $(basename $(source))))

TEST_TARGETS := $(foreach source,$(TEST_SOURCES), \
	$(notdir $(patsubst %.S,%,$(source))))

# パスからグループ名とテスト名を組み合わせる
TEST_IDS := $(foreach source,$(TEST_SOURCES), \
	$(notdir $(patsubst %/,%,$(dir $(source))))-$(notdir $(basename $(source))))

TEST_ELFS := $(addprefix $(RISCV_OUTPUT_DIR)/,$(addsuffix .elf,$(TEST_IDS)))
TEST_BINS := $(addprefix $(RISCV_OUTPUT_DIR)/,$(addsuffix .bin,$(TEST_IDS)))
TEST_DUMPS := $(addprefix $(RISCV_OUTPUT_DIR)/,$(addsuffix .dump,$(TEST_IDS)))
TEST_MEMS := $(addprefix $(RISCV_OUTPUT_DIR)/,$(addsuffix .mem,$(TEST_IDS)))

# RV32 sources include RV64 .S files; startup lives in env/p/riscv_test.h.
RISCV_BUILD_DEPS := $(lastword $(MAKEFILE_LIST)) \
	$(wildcard $(RISCV_TEST_ROOT)/env/p/*.h $(RISCV_TEST_ROOT)/env/*.h) \
	$(wildcard $(RISCV_TEST_ROOT)/isa/macros/scalar/*.h) \
	$(wildcard $(RISCV_TEST_ROOT)/isa/rv32ui/*.S $(RISCV_TEST_ROOT)/isa/rv32um/*.S) \
	$(wildcard $(RISCV_TEST_ROOT)/isa/rv64ui/*.S $(RISCV_TEST_ROOT)/isa/rv64um/*.S)

# ============================================================
# Compiler flags
# ============================================================

RISCV_COMMON_CFLAGS := \
	-mabi=$(ABI) \
	-nostdlib \
	-nostartfiles \
	-static \
	-mcmodel=medany \
	-fvisibility=hidden \
	-I $(RISCV_TEST_ROOT)/env/p \
	-I $(RISCV_TEST_ROOT)/env \
	-I $(RISCV_TEST_ROOT)/isa/macros/scalar

RISCV_LDFLAGS := \
	-T $(RISCV_LINKER_SCRIPT)

# グループごとのISA設定
ARCH_rv32ui := rv32i_zicsr_zifencei
ARCH_rv32um := rv32im_zicsr_zifencei
ARCH_rv64ui := rv64i_zicsr_zifencei

# ============================================================
# Targets
# ============================================================

.PHONY: \
	all \
	build \
	dump \
	bin \
	mem \
	list \
	clean \
	help

all: build dump mem

# Keep intermediate binaries; do not delete other tests' build artifacts.
.SECONDARY:

build: $(TEST_ELFS)

dump: $(TEST_DUMPS)

bin: $(TEST_BINS)

mem: $(TEST_MEMS)

# ============================================================
# ELF build
#
# $*:
#   rv32ui-add
#   rv32um-mul
#
# group:
#   rv32ui
#   rv32um
#
# test:
#   add
#   mul
# ============================================================

define BUILD_ELF_template

$(RISCV_OUTPUT_DIR)/$(1)-%.elf: \
	$(RISCV_TEST_ROOT)/isa/$(1)/%.S \
	$(RISCV_LINKER_SCRIPT) $(RISCV_BUILD_DEPS)
	@mkdir -p $(RISCV_OUTPUT_DIR)
	@echo "========================================"
	@echo "[BUILD] $(1)-$$*"
	@echo "[ARCH ] $$(ARCH_$(1)) / $$(ABI) / p"
	@echo "[SRC  ] $$<"
	@echo "[ELF  ] $$@"
	@echo "========================================"
	$$(RISCV_GCC) \
		-march=$$(ARCH_$(1)) \
		$$(RISCV_COMMON_CFLAGS) \
		$$(RISCV_LDFLAGS) \
		$$< \
		-o $$@

endef

$(foreach group,$(TEST_GROUPS), \
	$(eval $(call BUILD_ELF_template,$(group))))

# ============================================================
# Disassembly dump
# ============================================================

$(RISCV_OUTPUT_DIR)/%.dump: $(RISCV_OUTPUT_DIR)/%.elf
	@echo "[DUMP ] $@"
	$(RISCV_OBJDUMP) -D $< > $@

# ============================================================
# Raw binary
# ============================================================

$(RISCV_OUTPUT_DIR)/%.bin: $(RISCV_OUTPUT_DIR)/%.elf
	@echo "[BIN  ] $@"
	$(RISCV_OBJCOPY) -O binary $< $@

# ============================================================
# PSC-ONE memory image
#
# 32-bit little-endian binary data is converted into
# one 32-bit hexadecimal word per line.
# ============================================================

$(RISCV_OUTPUT_DIR)/%.mem: $(RISCV_OUTPUT_DIR)/%.bin
	@echo "[MEM  ] $@"
	hexdump -v -e '1/4 "%08x\n"' $< > $@

# ============================================================
# Test list
# ============================================================

list:
	@echo "ISA=$(ISA) ABI=$(ABI) ENV=p"
	@echo "TEST_GROUPS=$(TEST_GROUPS)"
	@echo ""
	@echo "Detected tests:"
	@$(foreach id,$(TEST_IDS),echo "  $(id)";)
	@echo ""
	@echo "Total: $(words $(TEST_IDS)) tests"

# ============================================================
# Clean
# ============================================================

clean:
	rm -rf $(RISCV_BUILD_DIR)

# ============================================================
# Help
# ============================================================

help:
	@echo "Usage:"
	@echo ""
	@echo "  Build all default groups:"
	@echo "    make -f Makefile.riscv"
	@echo ""
	@echo "  Build only RV32I tests:"
	@echo "    make -f Makefile.riscv TEST_GROUPS=\"rv32ui\""
	@echo ""
	@echo "  Build RV32I and RV32M tests:"
	@echo "    make -f Makefile.riscv TEST_GROUPS=\"rv32ui rv32um\""
	@echo ""
	@echo "  Generate only ELF files:"
	@echo "    make -f Makefile.riscv build"
	@echo "  Build RV64UI tests:"
	@echo "    make -f Makefile.riscv ISA=rv64ui"
	@echo ""
	@echo "  Generate only BIN files:"
	@echo "    make -f Makefile.riscv bin"
	@echo ""
	@echo "  Generate only MEM files:"
	@echo "    make -f Makefile.riscv mem"
	@echo ""
	@echo "  Show detected test programs:"
	@echo "    make -f Makefile.riscv list"
	@echo ""
	@echo "  Clean generated files:"
	@echo "    make -f Makefile.riscv clean"
	@echo ""
	@echo "Build directory:"
	@echo "  $(RISCV_OUTPUT_DIR)"
