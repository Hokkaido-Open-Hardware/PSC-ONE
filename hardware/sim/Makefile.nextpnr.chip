# ============================================================
# PSC-ONE full-chip timing flow with nextpnr / Himbaechel
#
# Usage:
#   make -f Makefile.nextpnr.chip timing
#   make -f Makefile.nextpnr.chip timing CPU_VERSION=v1 NPU_VERSION=v1
#
# Optional:
#   make -f Makefile.nextpnr.chip timing FREQ=81
#
# Target FPGA:
#   Tang Nano 20K
#   GW2AR-LV18QN88C8/I7
#   family = GW2A-18C
#
# Notes:
#   - Full PSC_ONE_Chip synthesis / place-and-route.
#   - Simulation-only SDRAM / SD / LCD / I2S models are NOT included.
#   - CPU v1/v2 SystemVerilog is converted by sv2v before Yosys.
#   - NPU v1 is the default.
# ============================================================

SHELL := /bin/bash

YOSYS   ?= ./yosys/build/yosys
NEXTPNR ?= nextpnr-himbaechel
SV2V    ?= sv2v

DEVICE ?= GW2AR-LV18QN88C8/I7
FAMILY ?= GW2A-18C
FREQ   ?= 81

TOP := PSC_ONE_Chip

# ============================================================
# Top
# ============================================================

TOP_SRC_DIR := ../rtl/tang20k/top
SOC_TOP_SRC_DIR := ../rtl/soc/soc_top

CHIP_TOP_FILE := \
	$(TOP_SRC_DIR)/PSC_ONE_Chip.v

SOC_TOP_FILE := \
	$(SOC_TOP_SRC_DIR)/PSC_ONE_SOC.v

# ============================================================
# CPU
# ============================================================

CPU_SRC_DIR := ../rtl/soc/cpu/src

CPU_CORE_FILES = \
	$(CPU_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_SRC_DIR)/PSC_RV32_core.v \
	$(CPU_SRC_DIR)/PSC_RV32_Fetch.v \
	$(CPU_SRC_DIR)/PSC_RV32_Execute.v \
	$(CPU_SRC_DIR)/Fetch_Fifo.v \
	$(CPU_SRC_DIR)/Fetch.v \
	$(CPU_SRC_DIR)/Decorder.v \
	$(CPU_SRC_DIR)/Execute.v \
	$(CPU_SRC_DIR)/Execute_Divider.v \
	$(CPU_SRC_DIR)/Execute_Mul.v \
	$(CPU_SRC_DIR)/Branch.v \
	$(CPU_SRC_DIR)/MemoryStore.v \
	$(CPU_SRC_DIR)/Register.v \
	$(CPU_SRC_DIR)/MMU.v \
	$(CPU_SRC_DIR)/Csr.v \
	$(CPU_SRC_DIR)/PSC_RV32_Monitor.v

CPU_V1_SRC_DIR := ../rtl/soc/cpu_v1/src

CPU_V1_CORE_FILES = \
	$(CPU_V1_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_V1_SRC_DIR)/PSC_Types.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_core.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_FetchUnit.sv \
	$(CPU_V1_SRC_DIR)/PSC_FetchPredict.sv \
	$(CPU_V1_SRC_DIR)/Fetch_Fifo.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_InstructionEngine.sv \
	$(CPU_V1_SRC_DIR)/PSC_InstructionUnit.sv \
	$(CPU_V1_SRC_DIR)/Fetch.sv \
	$(CPU_V1_SRC_DIR)/Decorder.sv \
	$(CPU_V1_SRC_DIR)/Execute.sv \
	$(CPU_V1_SRC_DIR)/Execute_Divider.sv \
	$(CPU_V1_SRC_DIR)/Execute_Mul.sv \
	$(CPU_V1_SRC_DIR)/Branch.sv \
	$(CPU_V1_SRC_DIR)/MemoryStore.sv \
	$(CPU_V1_SRC_DIR)/PSC_Register.sv \
	$(CPU_V1_SRC_DIR)/PSC_PC.sv \
	$(CPU_V1_SRC_DIR)/MMU.sv \
	$(CPU_V1_SRC_DIR)/Csr.sv \
	$(CPU_V1_SRC_DIR)/PSC_RV32_Monitor.v

CPU_V2_SRC_DIR := ../rtl/soc/cpu_v2_experimental/src

CPU_V2_CORE_FILES = \
	$(CPU_V2_SRC_DIR)/PSC_ONE_RV32_core.v \
	$(CPU_V2_SRC_DIR)/PSC_Types.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_core.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_FetchUnit.sv \
	$(CPU_V2_SRC_DIR)/Fetch_Fifo.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_InstructionEngine.sv \
	$(CPU_V2_SRC_DIR)/PSC_InstructionUnit.sv \
	$(CPU_V2_SRC_DIR)/Fetch.sv \
	$(CPU_V2_SRC_DIR)/Decorder.sv \
	$(CPU_V2_SRC_DIR)/Execute.sv \
	$(CPU_V2_SRC_DIR)/Execute_Divider.sv \
	$(CPU_V2_SRC_DIR)/Execute_Mul.sv \
	$(CPU_V2_SRC_DIR)/Branch.sv \
	$(CPU_V2_SRC_DIR)/MemoryStore.sv \
	$(CPU_V2_SRC_DIR)/PSC_Register.sv \
	$(CPU_V2_SRC_DIR)/PSC_PC.sv \
	$(CPU_V2_SRC_DIR)/MMU.sv \
	$(CPU_V2_SRC_DIR)/Csr.sv \
	$(CPU_V2_SRC_DIR)/PSC_RV32_Monitor.v

CPU_VERSION ?= v1

ifeq ($(CPU_VERSION),v1)
SELECTED_CPU_CORE_FILES := $(CPU_V1_CORE_FILES)
USE_SV2V := 1
else ifeq ($(CPU_VERSION),v2)
SELECTED_CPU_CORE_FILES := $(CPU_V2_CORE_FILES)
USE_SV2V := 1
else ifeq ($(CPU_VERSION),legacy)
SELECTED_CPU_CORE_FILES := $(CPU_CORE_FILES)
USE_SV2V := 0
else
$(error CPU_VERSION=$(CPU_VERSION) is invalid. Use v1 / v2 / legacy)
endif

# ============================================================
# CPU peripheral / cache
# ============================================================

CACHE_DIR := ../rtl/soc/cache/src
MMIO_DIR  := ../rtl/soc/mmio/MMIO
UART_DIR  := ../rtl/soc/mmio/UART
LED_DIR   := ../rtl/soc/mmio/LED

CPU_FILES = \
	$(SELECTED_CPU_CORE_FILES) \
	$(MMIO_DIR)/PSC_RV32IS_MMapped_IO.v \
	$(UART_DIR)/PSC_RV32IS_UART.v \
	$(LED_DIR)/PSC_RV32IS_LED.v \
	$(CACHE_DIR)/cache_dma_controller.sv \
	$(CACHE_DIR)/cache_dma_controller_io.sv \
	$(CACHE_DIR)/dm_cache_data.v \
	$(CACHE_DIR)/dm_cache_tag.v \
	$(TOP_SRC_DIR)/Delay_N.v

# ============================================================
# AXI / SDRAM / Boot / DMA
# ============================================================

AXI_DIR       := ../rtl/soc/axi
SDRAM_CNT_DIR := ../rtl/tang20k/sdram_controller
BOOT_SRC_DIR  := ../rtl/soc/boot
DMA_SRC_DIR   := ../rtl/soc/dma

MEMORY_FILES = \
	$(AXI_DIR)/sdram_32bit_to_256bit_axi_bridge.v \
	$(SDRAM_CNT_DIR)/sdram_axi_controller.v \
	$(SDRAM_CNT_DIR)/sdram_controller.sv \
	$(BOOT_SRC_DIR)/PSC_ONE_Boot_axi.v \
	$(DMA_SRC_DIR)/PSC_ONE_DMA_axi.v

# ============================================================
# NPU (v1 / legacy)
# ============================================================

NPU_VERSION ?= v1

NPU_LEGACY_DIR := ../rtl/soc/npu/src
NPU_V1_DIR     := ../rtl/soc/npu_v1/src

NPU_V1_FILES = \
	$(NPU_V1_DIR)/PSC_NPU_Controller.v \
	$(NPU_V1_DIR)/PSC_NPU_ReadController.v \
	$(NPU_V1_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_V1_DIR)/PSC_NPU_MACScheduler.sv \
	$(NPU_V1_DIR)/PSC_NPU_Mul4.sv \
	$(NPU_V1_DIR)/PSC_NPU_AccBank.sv

NPU_LEGACY_FILES = \
	$(NPU_LEGACY_DIR)/PSC_NPU_Controller.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_ReadController.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_SystolicArray4x4.v \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_INT.sv \
	$(NPU_LEGACY_DIR)/PSC_NPU_PE_Mult.sv

ifeq ($(NPU_VERSION),v1)
NPU_FILES := $(NPU_V1_FILES)
else ifeq ($(NPU_VERSION),legacy)
NPU_FILES := $(NPU_LEGACY_FILES)
else
$(error NPU_VERSION=$(NPU_VERSION) is invalid. Use v1 / legacy)
endif

# ============================================================
# MMIO peripherals
# ============================================================

MMIO_BASE_DIR := ../rtl/soc/mmio

LCD_FILES = \
	$(MMIO_BASE_DIR)/LCD/PSC_ONE_LCD.v \
	$(MMIO_BASE_DIR)/LCD/tft_clock_divider.v \
	$(MMIO_BASE_DIR)/LCD/tft_ili9488.v \
	$(MMIO_BASE_DIR)/LCD/tft_ili9488_spi.v

SD_FILES = \
	$(MMIO_BASE_DIR)/PSC_SDCARD/src/PSC_SDCard.sv \
	$(MMIO_BASE_DIR)/PSC_SDCARD/src/PSC_SDCard_SPI.sv

TIMER_FILES = \
	$(MMIO_BASE_DIR)/TIMER/PSC_RV32IS_TIMER.v

I2S_FILES = \
	$(MMIO_BASE_DIR)/I2S_RX/PSC_I2SRX.sv

FPE_FILES = \
	../rtl/soc/pfe/src/PSC_PFE.v

# ============================================================
# Full chip source list
# ============================================================

CHIP_FILES = \
	$(CHIP_TOP_FILE) \
	$(SOC_TOP_FILE) \
	$(CPU_FILES) \
	$(MEMORY_FILES) \
	$(NPU_FILES) \
	$(LCD_FILES) \
	$(SD_FILES) \
	$(TIMER_FILES) \
	$(I2S_FILES) \
	$(FPE_FILES)

# ============================================================
# CST
# Override from command line if the project uses another path:
#   make -f Makefile.nextpnr.chip timing CHIP_CST=../path/to/file.cst
# ============================================================

CHIP_CST ?= ../rtl/tang20k/timing/PSC_ONE_tang20k_cst.cst

# ============================================================
# Build files
# ============================================================

BUILD_DIR   ?= build_nextpnr_chip
CONVERTED_V := $(BUILD_DIR)/chip_converted.v
JSON        := $(BUILD_DIR)/chip.json
PNR_JSON    := $(BUILD_DIR)/chip_pnr.json
YOSYS_LOG   := $(BUILD_DIR)/yosys_chip.log
NEXTPNR_LOG := $(BUILD_DIR)/nextpnr_chip.log
REPORT      := $(BUILD_DIR)/timing_chip.json

.PHONY: all check-tools check-files synth pnr timing report clean

all: timing

# ============================================================
# Checks
# ============================================================

check-tools:
	@command -v $(YOSYS) >/dev/null 2>&1 || { \
		echo "[ERROR] yosys not found"; exit 1; }
	@command -v $(NEXTPNR) >/dev/null 2>&1 || { \
		echo "[ERROR] nextpnr-himbaechel not found"; exit 1; }
	@echo "[OK] yosys   : $$(command -v $(YOSYS))"
	@echo "[OK] nextpnr : $$(command -v $(NEXTPNR))"
	@$(NEXTPNR) --version
ifeq ($(USE_SV2V),1)
	@command -v $(SV2V) >/dev/null 2>&1 || { \
		echo "[ERROR] sv2v not found"; exit 1; }
	@echo "[OK] sv2v    : $$(command -v $(SV2V))"
endif

check-files:
	@for f in $(CHIP_FILES); do \
		test -f "$$f" || { \
			echo "[ERROR] source file not found: $$f"; exit 1; \
		}; \
	done
	@test -f "$(CHIP_CST)" || { \
		echo "[ERROR] CST not found: $(CHIP_CST)"; \
		echo "        Set CHIP_CST=<actual .cst path>"; \
		exit 1; \
	}
	@echo "[OK] CPU_VERSION : $(CPU_VERSION)"
	@echo "[OK] NPU_VERSION : $(NPU_VERSION)"
	@echo "[OK] TOP         : $(TOP)"
	@echo "[OK] CST         : $(CHIP_CST)"
	@echo "[OK] source files:"
	@for f in $(CHIP_FILES); do echo "     $$f"; done

# ============================================================
# Yosys synthesis
# ============================================================

synth: check-tools check-files
	@mkdir -p $(BUILD_DIR)
	@echo "============================================================"
	@echo " PSC-ONE full chip"
	@echo " CPU_VERSION : $(CPU_VERSION)"
	@echo " NPU_VERSION : $(NPU_VERSION)"
	@echo " TOP         : $(TOP)"
	@echo " DEVICE      : $(DEVICE)"
	@echo " FAMILY      : $(FAMILY)"
	@echo " TARGET FREQ : $(FREQ) MHz"
	@echo "============================================================"
ifeq ($(USE_SV2V),1)
	$(SV2V) -DYOSYS $(CHIP_FILES) > $(CONVERTED_V)
	$(YOSYS) -l $(YOSYS_LOG) -p " \
		read_verilog $(CONVERTED_V); \
		hierarchy -check -top $(TOP); \
		flatten; \
		synth_gowin -top $(TOP) -family gw2a -json $(JSON); \
		stat \
	"
else
	$(YOSYS) -l $(YOSYS_LOG) -p " \
		read_verilog -sv $(CHIP_FILES); \
		hierarchy -check -top $(TOP); \
		flatten; \
		synth_gowin -top $(TOP) -family gw2a -json $(JSON); \
		stat \
	"
endif
	@echo "[OK] JSON : $(JSON)"
	@echo "[OK] LOG  : $(YOSYS_LOG)"

# ============================================================
# nextpnr
# ============================================================

pnr: synth
	@mkdir -p $(BUILD_DIR)
	@set -o pipefail; \
	$(NEXTPNR) \
		--json $(JSON) \
		--write $(PNR_JSON) \
		--device $(DEVICE) \
		--vopt family=$(FAMILY) \
		--vopt cst=$(CHIP_CST) \
		--freq $(FREQ) \
		--report $(REPORT) \
		2>&1 | tee $(NEXTPNR_LOG)
	@echo "[OK] P&R JSON : $(PNR_JSON)"
	@echo "[OK] REPORT   : $(REPORT)"
	@echo "[OK] LOG      : $(NEXTPNR_LOG)"

# ============================================================
# Timing summary
# ============================================================

timing: pnr
	@echo "============================================================"
	@echo " PSC-ONE full-chip nextpnr timing summary"
	@echo "============================================================"
	@grep -Ei \
		'Max frequency|MHz|critical path|slack|timing|logic utilisation|utilization|Device utilisation' \
		$(NEXTPNR_LOG) | tail -n 240 || true
	@echo "Full log:    $(NEXTPNR_LOG)"
	@echo "JSON report: $(REPORT)"

report:
	@if [ ! -f "$(NEXTPNR_LOG)" ]; then \
		echo "[ERROR] $(NEXTPNR_LOG) not found. Run timing first."; \
		exit 1; \
	fi
	@grep -Ei \
		'Max frequency|MHz|critical path|slack|timing|logic utilisation|utilization|Device utilisation' \
		$(NEXTPNR_LOG) | tail -n 240 || true

clean:
	rm -rf $(BUILD_DIR)